index a52a2e14..ac621f0b 100644
--- a/libs/video/rsx_vertex_fetch.h
+++ b/libs/video/rsx_vertex_fetch.h
@@ -68,6 +68,23 @@ float rsx_rd_half_be(const u8* p);  /* 2-byte IEEE half -> float  */
  */
 void rsx_fetch_attrib(const rsx_state* st, int idx, u32 vi, float out[4]);
 
+/* All 16 attributes of one vertex, the same as 16 rsx_fetch_attrib calls but
+ * without working each array out again for every vertex: a heavy frame fetches
+ * a million vertices, and that was over half of the RSX thread's time.
+ * rsx_fetch_vertex_begin takes the attribute state of one draw, so it runs again
+ * for every draw. The address translation is kept per 1 MB, the IO page size.
+ * `inputs` has a bit for each attribute the draw's vertex program reads; the
+ * others are left unwritten. */
+typedef struct rsx_attrib_fetch {
+    const rsx_vertex_attrib* a;
+    const u8* base;   /* host address of the window `page` */
+    u32 offset, page, n;
+    int local;
+    int mode;         /* 0 constant register, 1 array, 2 array with a divisor, 3 not read */
+} rsx_attrib_fetch;
+void rsx_fetch_vertex_begin(const rsx_state* st, u32 inputs, rsx_attrib_fetch f[16]);
+void rsx_fetch_vertex(const rsx_state* st, rsx_attrib_fetch f[16], u32 vi, float out[16][4]);
+
 #ifdef __cplusplus
 }
 #endif

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 13:52:26 +0200
Subject: [PATCH] D3D12 backend: fragment constants per draw, and the alpha
 test

The pipeline key leaves fragment constants out on the understanding that the
shader reads them per draw, but the programs were decompiled with the constants
baked in. Every material sharing a program took the colours of the first draw
compiled. Sonic the Hedgehog's fur is 0.09,0.16,0.51 in its model and drew in the
near white of another material. The buffered decompile now reads them from b1,
behind the slot's head, and a program with more than 75 baked as before.

Alpha test was recorded and written to b1, and no shader read it, so every
cutout texture came out as an opaque rectangle. It is now part of the pipeline
key, and only pipelines that need it discard.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/video/rsx_d3d12_backend.c | 80 +++++++++++++++++++++++++++++-----
 1 file changed, 68 insertions(+), 12 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 24ca0664..0414a637 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -72,9 +72,10 @@
  * own texScale/offset uniforms, so one per-frame snapshot ran every pass
  * with the LAST pass's constants. */
 #define VP_CB_STRIDE      8448
-/* b1 per-draw FP slot: rsx_texscale[4] + rsx_alphatest + fp_k[64]
- * = 69 float4 = 1104 B, rounded to D3D12's 256-byte CBV alignment. */
+/* b1 per-draw FP slot: rsx_texscale[4] + rsx_alphatest + fp_k[], in a slot of
+ * 80 float4 = 1280 B, D3D12's 256-byte CBV alignment. */
 #define VP_FPCB_STRIDE    1280
+#define VP_FPK_SLOTS      75    /* what is left of the slot after the 5 float4 head */
 #define VERTEX_STRIDE       36  /* bytes per host vertex: pos3 + col4 + uv2 */
 
 typedef struct {
@@ -261,6 +262,7 @@ typedef struct {
                              * stale compile forever. */
     u32 cmask;              /* colour write mask (PSO key) */
     u32 cull;               /* packed face culling (PSO key) */
+    u32 alpha_key;          /* alpha test (PSO key): 0 off, else function | ref << 16 */
     u32 shadow_key;         /* depth-compare setup of the units (PSO key): the HLSL
                              * compares inside the program */
     u32 cube_mask;          /* which units are cube textures (PSO key): the HLSL
@@ -1966,6 +1968,26 @@ static u32 vp_hash_ucode(const u8* p, u32 n)
     return h ? h : 1u;
 }
 
+/* The alpha test of a draw, as vp_get_fp_pso keys it. D3D12 has no fixed alpha
+ * test, so the shader discards: only pipelines that need it pay for the lost
+ * early depth test. A cutout texture drawn without it fills its holes. */
+static u32 dr_alpha_key(const D3D12DrawRecord* dr)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("NO_ALPHATEST") ? 1 : 0;
+    if (off || !((dr->alpha_ctl >> 16) & 1u)) return 0;
+    const u32 cmp = (dr->alpha_ctl >> 8) & 7u;
+    return cmp == 7u ? 0 : (0x200u | cmp) | ((dr->alpha_ctl & 0xFFu) << 16);
+}
+
+/* FP_CONSTBUF=0: bake the constants, and put them in the pipeline key. */
+static int fp_consts_inline(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("FP_CONSTBUF"); v = (e && e[0] == '0') ? 1 : 0; }
+    return v;
+}
+
 #include "rsx_vp_decompiler.h"
 static int vp_get_vs(const rsx_state* st)
 {
@@ -2387,7 +2409,8 @@ static u32 dr_fp_units(const D3D12DrawRecord* dr)
 static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, int nrt,
                                           DXGI_FORMAT rtfmt, u32 ctrl, u32 cmask, u32 cull,
                                           u32 cube_mask, u64 zs,
-                                          const rsx_fp_shadow_desc* shadow, u32 shadow_key)
+                                          const rsx_fp_shadow_desc* shadow, u32 shadow_key,
+                                          u32 alpha_key)
 {
     if (nrt < 0) nrt = 0; if (nrt > 4) nrt = 4;   /* 0: a depth-only pass */
     if (rtfmt == 0) rtfmt = DXGI_FORMAT_R8G8B8A8_UNORM;
@@ -2419,10 +2442,7 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
         u32 usz = rsx_fp_program_size(vm_base + off, 4096);
         if (usz == 0) usz = 64;
         s_perf_pso_hashbytes += (int)usz;
-        static int consts_inline = -1;
-        if (consts_inline < 0) { const char* e = getenv("FP_CONSTBUF");
-                                 consts_inline = (e && e[0] == '0') ? 1 : 0; }
-        if (consts_inline) {
+        if (fp_consts_inline()) {
             uhash = 2166136261u;
             const u8* up = vm_base + off;
             for (u32 i = 0; i < usz; i++) { uhash ^= up[i]; uhash *= 16777619u; }
@@ -2447,7 +2467,7 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
             s_d3d.vp_fp[i].ucode_hash == uhash && s_d3d.vp_fp[i].cmask == cmask &&
             s_d3d.vp_fp[i].cull == cull &&
             s_d3d.vp_fp[i].cube_mask == cube_mask && s_d3d.vp_fp[i].zs == zs &&
-            s_d3d.vp_fp[i].shadow_key == shadow_key)
+            s_d3d.vp_fp[i].shadow_key == shadow_key && s_d3d.vp_fp[i].alpha_key == alpha_key)
             return s_d3d.vp_fp[i].pso;
     s_perf_pso_miss++;      /* falls through to a full decompile + D3DCompile */
     /* PSOMISSDBG=1: on a miss, name the key field that differs from an existing
@@ -2511,9 +2531,44 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
     static int ctrl_auto = -1;
     if (ctrl_auto < 0) ctrl_auto = getenv("RSX_FP_CTRL_AUTO") ? 1 : 0;
     u32 fp_ctrl = ctrl_auto ? RSX_FP_CTRL_AUTO : ctrl;
-    int n = shadow_key ? rsx_fp_decompile_shadow_ex(vm_base + off, 4096, fp_ctrl, 0, shadow,
+    /* The pipeline key leaves the constants out, so the shader must not bake
+     * them: it reads them from b1, refilled for every draw from the draw's own
+     * ucode. Baked, every material sharing a program took the colours of the
+     * first draw compiled: Sonic's fur has the diffuse 0.09,0.16,0.51 in his
+     * model, and he drew with the near-white of whatever came first. */
+    u32 fp_nk = 0;
+    int n = -1, alpha_done = 0;
+    if (!fp_consts_inline()) {
+        n = shadow_key
+            ? rsx_fp_decompile_buffered_shadow_ex(vm_base + off, 4096, fp_ctrl, 0, shadow,
+                                                  hlsl, sizeof(hlsl), &fp_nk)
+            : rsx_fp_decompile_buffered_ex(vm_base + off, 4096, fp_ctrl, 0,
+                                           hlsl, sizeof(hlsl), &fp_nk);
+        if (n > 0 && fp_nk > VP_FPK_SLOTS) {
+            static int _w = 0;
+            if (PS3_LOG_FIRST(_w, 8))
+                fprintf(stderr, "[FP] fp=0x%X has %u constants, %u fit: baking them%c",
+                        fp_addr, fp_nk, VP_FPK_SLOTS, 10);
+            n = -1;
+        }
+        if (n > 0) {   /* the slot starts with what vp_record_cb puts in front */
+            char from[128], to[192];
+            snprintf(from, sizeof from, "cbuffer PSConstants : register(b1) {\n"
+                     "    float4 fp_constants[%u];\n    float4 fp_alpha;\n};\n", fp_nk ? fp_nk : 1u);
+            snprintf(to, sizeof to, "cbuffer PSConstants : register(b1) {\n"
+                     "    float4 rsx_b1_head[4];\n    float4 rsx_alphatest;\n"
+                     "    float4 fp_constants[%u];\n};\n"
+                     "#define fp_alpha float4(rsx_alphatest.y, 0.0, 0.0, 0.0)\n", VP_FPK_SLOTS);
+            hlsl_replace_all(hlsl, sizeof hlsl, from, to);
+            if (alpha_key) alpha_done = rsx_fp_apply_alpha_test_buffered(hlsl, sizeof hlsl, alpha_key & 0xFFFFu);
+        }
+    }
+    if (n <= 0)
+        n = shadow_key ? rsx_fp_decompile_shadow_ex(vm_base + off, 4096, fp_ctrl, 0, shadow,
                                                     hlsl, sizeof(hlsl))
                        : rsx_fp_decompile(vm_base + off, 4096, fp_ctrl, hlsl, sizeof(hlsl));
+    if (n > 0 && alpha_key && !alpha_done)
+        rsx_fp_apply_alpha_test(hlsl, sizeof hlsl, alpha_key & 0xFFFFu, (float)(alpha_key >> 16) / 255.0f);
     if (n <= 0) { static int _e=0; if(PS3_LOG_FIRST(_e, 16)) printf("[FP] decompile fail (fp=0x%08X)\n", fp_addr); return NULL; }
     /* FP_LIST=1: every program the title actually compiles, with its size. A
      * fragment program that hangs the GPU shows up here as an implausible
@@ -2849,6 +2904,7 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
     s_d3d.vp_fp[s_d3d.vp_fp_n].cull    = cull;
     s_d3d.vp_fp[s_d3d.vp_fp_n].cube_mask = cube_mask;
     s_d3d.vp_fp[s_d3d.vp_fp_n].shadow_key = shadow_key;
+    s_d3d.vp_fp[s_d3d.vp_fp_n].alpha_key = alpha_key;
     s_d3d.vp_fp[s_d3d.vp_fp_n].zs      = zs;
     s_d3d.vp_fp[s_d3d.vp_fp_n].pso     = pso;
     s_d3d.vp_fp_n++;
@@ -3614,7 +3670,7 @@ static void vp_record_cb(u32 slot, int vs_idx, const D3D12DrawRecord* dr)
             u32 foff = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1,
                                              dr->fp_addr & ~0x3u);
             if (vm_base && foff != 0xFFFFFFFFu)
-                rsx_fp_extract_consts(vm_base + foff, 4096, &ts[20], 64);   /* fp_k[64] */
+                rsx_fp_extract_consts(vm_base + foff, 4096, &ts[20], VP_FPK_SLOTS);
             /* FPK_DBG=1: the fragment constants as the shader will see them.
              * A program whose only output is fp_k[0].xxxx renders black if
              * those constants never arrive, which looks identical from the
@@ -5077,7 +5133,7 @@ static void render_frame(void)
                                        dr->rt_off ? rsx_surface_dxgi(dr->rt_fmt)
                                                   : DXGI_FORMAT_R8G8B8A8_UNORM,
                                        dr->fp_ctrl, dr->cmask, dr->cull, dr_cube_mask(dr),
-                                       dr->zs_key, shadow, shadow_key);
+                                       dr->zs_key, shadow, shadow_key, dr_alpha_key(dr));
         if (perf_on()) s_perf_pso += perf_now() - _ps0;
     }
 
@@ -5465,7 +5521,7 @@ static void render_frame(void)
                                                            : DXGI_FORMAT_R8G8B8A8_UNORM,
                                                 dr->fp_ctrl, dr->cmask, dr->cull,
                                                 dr_cube_mask(dr), dr->zs_key,
-                                                shadow, shadow_key) : NULL;
+                                                shadow, shadow_key, dr_alpha_key(dr)) : NULL;
                 s_d3d.cmd_list->lpVtbl->SetPipelineState(s_d3d.cmd_list,
                                                          dpso ? dpso : vpso);
                 s_d3d.cmd_list->lpVtbl->OMSetStencilRef(s_d3d.cmd_list, dr->stencil_ref & 0xFFu);

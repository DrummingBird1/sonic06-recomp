@@ -8336,6 +8419,34 @@ static u32 upload_strip_vp_indexed(const rsx_state* state, u32 first, u32 count,
     return o;
 }
 
+/* D3D12_SHADOWS=0: no shadow maps, for weak graphics cards. A draw into a
+ * square depth surface of 1024 or more with no colour target is a shadow map
+ * (Sonic 06: 2048x2048 DEPTH24_D8, sampled with a depth compare). Those draws
+ * are dropped before their vertices are converted; the map's clears still
+ * run, so it stays at the far plane and every compare reads "lit". */
+static int shadows_off(void)
+{
+    static int off = -1;
+    if (off < 0) {
+        const char* e = getenv("D3D12_SHADOWS");
+        off = e && *e == '0';
+        if (off) printf("[D3D12] D3D12_SHADOWS=0: shadow map draws are skipped\n");
+    }
+    return off;
+}
+
+static int skip_shadow_draw(void)
+{
+    if (!shadows_off()) return 0;
+    const rsx_state* st = s_d3d.current_rsx_state;
+    if (!st || st->color_target != 0 || !((st->surface_format >> 5) & 7u) || !st->surface_zeta_offset) return 0;
+    if (st->surface_clip_w < 1024 || st->surface_clip_w != st->surface_clip_h) return 0;
+    static int n;
+    if (PS3_LOG_FIRST(n, 1)) printf("[D3D12] shadows off: first skipped draw, %ux%u depth surface at 0x%X\n",
+                                      st->surface_clip_w, st->surface_clip_h, st->surface_zeta_offset);
+    return 1;
+}
+

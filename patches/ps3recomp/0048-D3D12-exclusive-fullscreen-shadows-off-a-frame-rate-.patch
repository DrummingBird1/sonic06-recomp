From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 00:44:16 +0200
Subject: [PATCH] D3D12: exclusive fullscreen, shadows off, a frame rate
 counter

D3D12_FULLSCREEN=exclusive puts the borderless window in DXGI's exclusive
fullscreen, enters it again after Alt+Tab, and leaves it before the window or
the swap chain goes. It needs the present pass; a driver that refuses it keeps
the borderless window.

D3D12_SHADOWS=0 drops draws into a square depth-only surface of 1024 or more
(the shadow map) before their vertices are converted; the map's clears still
run, so every compare reads lit.

D3D12_FPS=1 draws the last second's presents in the picture's corner, from the
present pass, so it shows in fullscreen too.
---
 libs/video/rsx_d3d12_backend.c | 130 +++++++++++++++++++++++++++++++--
 1 file changed, 122 insertions(+), 8 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 66033b6f..cc053279 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -301,6 +301,12 @@ typedef struct {
     ID3D12CommandQueue*        cmd_queue;
     IDXGISwapChain3*           swap_chain;
     int                        tearing;     /* D3D12_VSYNC=0 and the swap chain allows tearing */
+    UINT                       sc_flags;    /* the swap chain's creation flags, for ResizeBuffers */
+    /* D3D12_FULLSCREEN=exclusive: DXGI's own fullscreen. exclusive is asked
+     * for; fs_on is whether the swap chain is in it now (Alt+Tab leaves it);
+     * fs_retry asks the present thread to enter it again. */
+    int                        exclusive;
+    volatile LONG              fs_on, fs_retry;
     ID3D12DescriptorHeap*      rtv_heap;
     u32                        rtv_descriptor_size;
     ID3D12Resource*            render_targets[FRAME_COUNT];
@@ -724,6 +730,8 @@ static struct {
     ID3D12PipelineState* pso;
     float scaler, fxaa, sharpen, gamma, saturation, contrast;
     int keep_aspect;
+    int fps_on;                        /* D3D12_FPS=1 */
+    float fps;                         /* the last second's presents, for the corner */
 } s_pp;
 
 static void pp_read_env(void)
@@ -751,6 +759,8 @@ static void pp_read_env(void)
     e = getenv("D3D12_CONTRAST");
     s_pp.contrast = e ? (float)atof(e) : 1.f;
     if (!(s_pp.contrast >= 0.5f && s_pp.contrast <= 1.5f)) s_pp.contrast = 1.f;
+    e = getenv("D3D12_FPS");
+    s_pp.fps_on = e && *e == '1';
     e = getenv("D3D12_RES_SCALE");
     s_rs = e ? (float)atof(e) : 1.f;
     if (!(s_rs >= 1.f && s_rs <= 4.f) || !s_pp.on) s_rs = 1.f;
@@ -769,13 +779,32 @@ static int d3d12_esc_closes(void)
     return c;
 }
 
+/* Leave exclusive fullscreen: DXGI wants that before the window or the swap
+ * chain goes away. Called on the thread that presents and pumps messages. */
+static void fs_leave(void)
+{
+    if (s_d3d.exclusive && s_d3d.swap_chain && s_d3d.fs_on) {
+        s_d3d.swap_chain->lpVtbl->SetFullscreenState(s_d3d.swap_chain, FALSE, NULL);
+        InterlockedExchange(&s_d3d.fs_on, 0);
+    }
+}
+
 static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
 {
     switch (msg) {
     case WM_CLOSE:
         s_d3d.window_closed = 1;
+        fs_leave();
         DestroyWindow(hwnd);
         return 0;
+    case WM_ACTIVATEAPP:
+        /* Alt+Tab took exclusive fullscreen away (DXGI leaves it on its own);
+         * back in front, the next present enters it again. */
+        if (s_d3d.exclusive) {
+            if (wp) InterlockedExchange(&s_d3d.fs_retry, 1);
+            else InterlockedExchange(&s_d3d.fs_on, 0);
+        }
+        break;
     case WM_DESTROY:
         PostQuitMessage(0);
         return 0;
@@ -789,6 +818,7 @@ static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
     case WM_KEYDOWN:
         if (wp == VK_ESCAPE && d3d12_esc_closes()) {
             s_d3d.window_closed = 1;
+            fs_leave();
             DestroyWindow(hwnd);
         }
         return 0;
@@ -870,6 +900,22 @@ static const char s_pp_hlsl[] =
     "  if (scaler > 1.5) return sharpbil(uv);\n"
     "  if (scaler > 0.5) return src.SampleLevel(pt, uv, 0).rgb;\n"
     "  return bil(uv); }\n"
+    /* D3D12_FPS=1: the frame rate in the top-left corner, pad_.x (0 = off).
+     * A 3x5 font, one 15-bit row-major glyph per digit, scaled with the
+     * picture, on a darkened box. */
+    "static const uint font[10] = { 31599, 11415, 29671, 29647, 23497, 31183, 31215, 29257, 31727, 31695 };\n"
+    "float3 fps_box(float2 p, float3 c) {\n"
+    "  int n = (int)(pad_.x + 0.5); int nd = n >= 100 ? 3 : n >= 10 ? 2 : 1;\n"
+    "  float s = max(2.0, floor(dstSize.y / 270.0));\n"
+    "  float2 q = (p - 8.0) / s;\n"
+    "  if (q.x < -1.0 || q.y < -1.0 || q.x >= nd * 4.0 || q.y >= 6.0) return c;\n"
+    "  c *= 0.3;\n"
+    "  int cx = (int)floor(q.x), cy = (int)floor(q.y);\n"
+    "  if (cx < 0 || cy < 0 || cy > 4 || (cx & 3) == 3) return c;\n"
+    "  int d = cx >> 2, v = n;\n"
+    "  for (int k = d; k < nd - 1; k++) v /= 10;\n"
+    "  uint bit = (font[v % 10] >> ((4 - cy) * 3 + (2 - (cx & 3)))) & 1;\n"
+    "  return bit ? float3(1.0, 0.95, 0.35) : c; }\n"
     "float4 ps_main(VO i) : SV_Target {\n"
     "  float3 c = base(i.uv);\n"
     "  if (sharpen > 0.0) {\n"
@@ -894,6 +940,7 @@ static const char s_pp_hlsl[] =
     "    float a = frac(52.9829189 * frac(dot(p, float2(0.06711056, 0.00583715))));\n"
     "    float b = frac(52.9829189 * frac(dot(p + float2(47.0, 17.0), float2(0.06711056, 0.00583715))));\n"
     "    c = saturate(c + (a + b - 1.0) / 255.0); }\n"
+    "  if (pad_.x > 0.0) c = fps_box(i.uv * dstSize, c);\n"   /* the picture's corner, not the window's */
     "  return float4(c, 1); }\n";
 
 /* The swap chain's buffers and their RTVs, after creation or a resize. */
@@ -1004,8 +1051,10 @@ static HWND create_window(u32 width, u32 height, const char* title)
 
     /* D3D12_WINDOW=<w>x<h>: the window's client size. The swap chain stays at

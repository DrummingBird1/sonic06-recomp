@@ -1189,9 +1239,17 @@ static int init_d3d12(u32 width, u32 height)
             factory5->lpVtbl->Release(factory5);
         }
         s_d3d.tearing = tear ? 1 : 0;
-        if (tear) sc_desc.Flags = DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING;
+        if (tear) sc_desc.Flags |= DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING;
         printf("[D3D12] D3D12_VSYNC=0: tearing %s\n", tear ? "allowed" : "not supported");
     }
+    /* Exclusive fullscreen resizes the buffers to the screen's own mode, so
+     * it needs the present pass (without it the buffers are the guest's). */
+    if (s_d3d.exclusive && !s_pp.on) {
+        printf("[D3D12] exclusive fullscreen needs the present pass: borderless instead\n");
+        s_d3d.exclusive = 0;
+    }
+    if (s_d3d.exclusive) sc_desc.Flags |= DXGI_SWAP_CHAIN_FLAG_ALLOW_MODE_SWITCH;
+    s_d3d.sc_flags = sc_desc.Flags;
 
     IDXGISwapChain1* swap_chain1 = NULL;
     hr = factory->lpVtbl->CreateSwapChainForHwnd(
@@ -1207,6 +1265,16 @@ static int init_d3d12(u32 width, u32 height)
     factory->lpVtbl->MakeWindowAssociation(factory, s_d3d.hwnd, DXGI_MWA_NO_ALT_ENTER);
     factory->lpVtbl->Release(factory);
 
+    /* The window already covers the screen at its own size, so DXGI keeps
+     * the desktop's mode; the present pass resizes the buffers on WM_SIZE. If
+     * the driver refuses, the borderless window stays, as it was before. */
+    if (s_d3d.exclusive) {
+        HRESULT fh = swap_chain1->lpVtbl->SetFullscreenState(swap_chain1, TRUE, NULL);
+        printf("[D3D12] exclusive fullscreen: %s (0x%08lX)\n", SUCCEEDED(fh) ? "on" : "refused, borderless instead", fh);
+        if (SUCCEEDED(fh)) InterlockedExchange(&s_d3d.fs_on, 1);
+        else s_d3d.exclusive = 0;
+    }
+
     /* Query SwapChain3 interface */
     hr = swap_chain1->lpVtbl->QueryInterface(
         swap_chain1, &IID_IDXGISwapChain3, (void**)&s_d3d.swap_chain);
@@ -5469,13 +5537,26 @@ static void guest_fb_present(u32 fi)
  * touched them yet; the frames in flight are drained first. */
 static void pp_resize_if_needed(void)
 {
+    /* Back from Alt+Tab with exclusive fullscreen asked for: enter it again.
+     * DXGI asks for ResizeBuffers after each change, size or not. */
+    int force = 0;
+    if (s_d3d.exclusive && InterlockedExchange(&s_d3d.fs_retry, 0)) {
+        BOOL now = FALSE;
+        s_d3d.swap_chain->lpVtbl->GetFullscreenState(s_d3d.swap_chain, &now, NULL);
+        if (!now) {
+            wait_for_gpu();
+            HRESULT fh = s_d3d.swap_chain->lpVtbl->SetFullscreenState(s_d3d.swap_chain, TRUE, NULL);
+            printf("[D3D12] exclusive fullscreen again: %s (0x%08lX)\n", SUCCEEDED(fh) ? "on" : "refused", fh);
+            if (SUCCEEDED(fh)) { InterlockedExchange(&s_d3d.fs_on, 1); force = 1; }
+        } else InterlockedExchange(&s_d3d.fs_on, 1);
+    }
     const LONG w = s_pp.want_w, h = s_pp.want_h;
-    if (w <= 0 || h <= 0 || ((u32)w == s_pp.sc_w && (u32)h == s_pp.sc_h)) return;
+    if (w <= 0 || h <= 0 || (!force && (u32)w == s_pp.sc_w && (u32)h == s_pp.sc_h)) return;
     wait_for_gpu();
     for (u32 i = 0; i < FRAME_COUNT; i++)
         if (s_pp.sc[i]) { s_pp.sc[i]->lpVtbl->Release(s_pp.sc[i]); s_pp.sc[i] = NULL; }
     HRESULT hr = s_d3d.swap_chain->lpVtbl->ResizeBuffers(s_d3d.swap_chain, FRAME_COUNT, (UINT)w, (UINT)h,
-                     DXGI_FORMAT_R8G8B8A8_UNORM, s_d3d.tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+                     DXGI_FORMAT_R8G8B8A8_UNORM, s_d3d.sc_flags);
     if (FAILED(hr)) printf("[D3D12] present pass: ResizeBuffers %ldx%ld failed (0x%08lX)\n", w, h, hr);
     else { s_pp.sc_w = (u32)w; s_pp.sc_h = (u32)h; }
     if (pp_get_buffers() != 0) printf("[D3D12] present pass: swap chain buffers lost after a resize\n");

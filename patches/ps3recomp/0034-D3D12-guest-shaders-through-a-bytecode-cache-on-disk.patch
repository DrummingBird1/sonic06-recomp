+/* ---------------------------------------------------------------------------
+ * Guest shaders through a bytecode cache on disk
+ *
+ * D3DCompile is where a new guest program costs its frame: FXC spends half a
+ * second on a skinned vertex program of 90 instructions, and a scene cut that
+ * brings a few in stopped Sonic the Hedgehog's story scene for 516 ms.
+ * Reshaping the generated HLSL took at most a third off. So a program compiled
+ * once is kept: on a later run it is a file read. The first time, FXC skips
+ * its optimiser: that compiles the slowest program 2.5x faster and halved the
+ * scene cut's stall, and the driver optimises the bytecode again when it
+ * builds the pipeline. Wave Ocean at 3840x2160 ran at 60 either way on an
+ * RTX 4070 SUPER; a weaker card has not been measured.
+ *
+ *   D3D12_SHADER_CACHE=<dir>   where (default: shadercache next to the exe); 0 = off
+ *   D3D12_SHADER_OPT=skip|0|1|3 D3DCompile's optimisation (default skip; 1 is FXC's own)
+ *   D3D12_SHADER_CACHE_DBG=1   every compile and every hit, with its time
+ *
+ * The key is a 64-bit FNV-1a of the HLSL, the target and the flags, so a change
+ * to the decompiler, the edits after it or the switches is a different file.
+ * Files are written to a temporary name and renamed, so a run killed halfway
+ * leaves no truncated bytecode; one that reads back without a whole DXBC
+ * container is compiled again.
+ * -------------------------------------------------------------------------*/
+static const char* shader_cache_dir(void)
+{
+    static int init = 0;
+    static char dir[MAX_PATH];
+    if (!init) {
+        init = 1;
+        const char* e = getenv("D3D12_SHADER_CACHE");
+        if (e && e[0] == '0' && !e[1]) dir[0] = 0;
+        else if (e && *e) snprintf(dir, sizeof dir, "%s", e);
+        else {
+            char exe[MAX_PATH];
+            DWORD n = GetModuleFileNameA(NULL, exe, sizeof exe);
+            char* slash = (n && n < sizeof exe) ? strrchr(exe, '\\') : NULL;
+            if (slash) { *slash = 0; snprintf(dir, sizeof dir, "%s\\shadercache", exe); }
+        }
+        if (dir[0] && !CreateDirectoryA(dir, NULL) && GetLastError() != ERROR_ALREADY_EXISTS) {
+            printf("[D3D12] shader cache %s unavailable, compiling every time\n", dir);
+            dir[0] = 0;
+        }
+        if (dir[0]) printf("[D3D12] shader cache: %s\n", dir);
+    }
+    return dir[0] ? dir : NULL;
+}
+
+static UINT shader_opt_flags(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("D3D12_SHADER_OPT");
+        v = (!e || !strcmp(e, "skip")) ? 4 : (e[0] >= '0' && e[0] <= '3') ? e[0] - '0' : 4;
+    }
+    return v == 4 ? D3DCOMPILE_SKIP_OPTIMIZATION : v == 0 ? D3DCOMPILE_OPTIMIZATION_LEVEL0 :
+           v == 2 ? D3DCOMPILE_OPTIMIZATION_LEVEL2 : v == 3 ? D3DCOMPILE_OPTIMIZATION_LEVEL3 : 0;
+}
+
+static u64 shader_key(const char* hlsl, size_t len, const char* target, UINT flags)
+{
+    u64 h = 0xCBF29CE484222325ull;
+    for (size_t i = 0; i < len; i++) { h ^= (u8)hlsl[i]; h *= 0x100000001B3ull; }
+    for (const char* t = target; *t; t++) { h ^= (u8)*t; h *= 0x100000001B3ull; }
+    h ^= flags; h *= 0x100000001B3ull;
+    return h;
+}
+
+/* A DXBC container: "DXBC", a 16-byte checksum, version 1, then its own size. */
+static int dxbc_whole(const u8* p, size_t n)
+{
+    return n >= 32 && !memcmp(p, "DXBC", 4) && *(const u32*)(p + 24) == (u32)n;
+}
+
+/* D3DCompile, through the cache. Same contract: *out on success, *err (may be
+ * NULL) with the compiler's messages on failure. kind is 0 for a vertex
+ * program, 1 for a fragment program (PS3_FTRACE). */
+static HRESULT shader_compile(const char* hlsl, size_t len, const char* name, const char* target,
+                              int kind, ID3DBlob** out, ID3DBlob** err)
+{
+    static unsigned hits, misses; static double miss_ms;
+    static int dbg = -1;
+    if (dbg < 0) dbg = getenv("D3D12_SHADER_CACHE_DBG") ? 1 : 0;
+    const UINT flags = shader_opt_flags();
+    const char* dir = shader_cache_dir();
+    const uint64_t ft0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+    const double t0 = perf_now();
+    char path[MAX_PATH + 64] = "";
+    *out = NULL;
+    if (err) *err = NULL;
+    if (dir) {
+        snprintf(path, sizeof path, "%s\\%016llx.%s.dxbc", dir,
+                 (unsigned long long)shader_key(hlsl, len, target, flags), target);
+        FILE* f = fopen(path, "rb");
+        if (f) {
+            fseek(f, 0, SEEK_END);
+            const long n = ftell(f);
+            fseek(f, 0, SEEK_SET);
+            ID3DBlob* b = NULL;
+            if (n > 0 && n < (64 << 20) && SUCCEEDED(D3DCreateBlob((SIZE_T)n, &b)) && b) {
+                u8* p = (u8*)b->lpVtbl->GetBufferPointer(b);
+                if (fread(p, 1, (size_t)n, f) == (size_t)n && dxbc_whole(p, (size_t)n)) {
+                    fclose(f);
+                    *out = b;
+                    hits++;
+                    if (dbg) printf("[shader] hit  %s %.2f ms (%u hits, %u compiled)\n", path, (perf_now() - t0) * 1000.0, hits, misses);
+                    if (ft0) ps3_ft_span(PS3_FT_COMPILE, 0, (u32)kind, 1u, ft0, ps3_ft_now());
+                    return S_OK;
+                }
+                b->lpVtbl->Release(b);
+            }
+            fclose(f);
+        }
+    }
+    HRESULT hr = D3DCompile(hlsl, len, name, NULL, NULL, "main", target, flags, 0, out, err);
+    const double ms = (perf_now() - t0) * 1000.0;
+    misses++; miss_ms += ms;
+    if (dbg) printf("[shader] compiled %s in %.1f ms (%u compiled, %.0f ms in all)\n", name, ms, misses, miss_ms);
+    if (ft0) ps3_ft_span(PS3_FT_COMPILE, 0, (u32)kind, 0u, ft0, ps3_ft_now());
+    if (SUCCEEDED(hr) && *out && path[0]) {
+        const u8* p = (const u8*)(*out)->lpVtbl->GetBufferPointer(*out);
+        const size_t n = (*out)->lpVtbl->GetBufferSize(*out);
+        char tmp[sizeof path + 16];
+        snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+        FILE* f = fopen(tmp, "wb");
+        if (f) {
+            const int ok = fwrite(p, 1, n, f) == n;
+            fclose(f);
+            if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+        }
+    }
+    return hr;
+}
+

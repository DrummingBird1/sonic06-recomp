+++ b/include/ps3emu/ps3_ftrace.h
@@ -61,6 +61,8 @@ enum ps3_ft_kind {
     PS3_FT_HLE         = 15, /* who = PPU tid, a = NID, b = guest lr: an HLE import call */
     PS3_FT_RECYCLE     = 16, /* the title's buffer-full callback waiting for the walker to reach the

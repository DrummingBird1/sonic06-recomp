From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sat, 31 Oct 2026 20:57:48 +0200
Subject: [PATCH] ppu_lifter: jump-table base that is both spilled and
 two-level

lwz r30,d1(r2) in the prologue, lwz r3,d2(r30); std r3,s(r1), then
ld r5,s(r1) at the dispatch. The spilled path only followed the stored
register to a one-level TOC load, so the dispatcher was dropped and its
bctr lifted to an unresolved indirect call (Sonic 06 Havok func_010CB728).
---
 tools/ppu_lifter.py | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/tools/ppu_lifter.py b/tools/ppu_lifter.py
index a657ba61..4119fb54 100644
--- a/tools/ppu_lifter.py
+++ b/tools/ppu_lifter.py
@@ -4695,6 +4695,24 @@ def discover_jump_tables(all_insns, read_u32, toc, text_lo, text_hi, func_starts
                             if w2.mnemonic in ('lwz', 'ld') and len(b) == 2 and '(r2)' in b[1]:
                                 disp = mem_disp(b[1]); r_base = cand
                                 base_is_ld = (w2.mnemonic == 'ld')
+                            elif w2.mnemonic in ('lwz', 'ld') and len(b) == 2 and '(' in b[1] \
+                                    and '(r1)' not in b[1]:
+                                # Spilled AND two-level: `lwz r30,d1(r2)` in the
+                                # prologue, `lwz r3,d2(r30); std r3,s(r1)`, then
+                                # `ld r5,s(r1)` at the dispatch. (Sonic 06's Havok
+                                # func_010CB728: its 26-case switch lifted to an
+                                # unresolved bctr, and HavokRunnerThread exited on
+                                # the first case it took.)
+                                _mid = b[1][b[1].index('(') + 1:-1].strip()
+                                for w3 in reversed([x for x in win_cand if x.addr < w2.addr]):
+                                    c = [x.strip() for x in w3.operands.split(',')]
+                                    if not c or c[0] != _mid or w3.mnemonic.startswith(('st', 'lf')):
+                                        continue
+                                    if w3.mnemonic in ('lwz', 'ld') and len(c) == 2 and '(r2)' in c[1]:
+                                        disp = mem_disp(c[1]); r_base = cand
+                                        base_is_ld = (w3.mnemonic == 'ld')
+                                        disp2 = mem_disp(b[1]); disp2_is_ld = (w2.mnemonic == 'ld')
+                                    break
                             break               # nearest definition wins, TOC load or not
                 elif w.mnemonic in ('lwz', 'ld') and len(a) == 2 and '(' in a[1]:
                     # TWO-LEVEL base: `lwz r30, d1(r2); lwz r11, d2(r30)`. The

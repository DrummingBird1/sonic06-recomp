+/* The buffer-full callback's wrap (cellGcm_fifo_recycle, cellGcmSys.c).
+ *
+ * A title flushes put once a frame, so when its ring fills, the tail is most
+ * of a frame the walker has not been let read. The wrap used to wait for the
+ * walker to read all of it; now it holds the context's end short of the
+ * walker and returns, and the walker gives the end back when it takes the
+ * JUMP to begin. With the walker too close to begin, the old wait stays, and
+ * a title that reaches the held end first waits there instead of wrapping
+ * again.
+ *
+ * gcc -std=gnu17 -I include -I libs/video libs/video/tests/test_gcm_recycle_hold.c
+ *   -ffunction-sections -fdata-sections -Wl,--gc-sections -pthread
+ *   -o /tmp/test_gcm_recycle_hold        (clang on macOS: -Wl,-dead_strip)
+ */
+#include "../cellGcmSys.c"
+#include <stdio.h>
+#include <stdlib.h>
+uint8_t* vm_base;
+uint32_t ppu_vm_size;
+int g_resv_store_active;
+uint32_t g_ww_lo, g_ww_hi;

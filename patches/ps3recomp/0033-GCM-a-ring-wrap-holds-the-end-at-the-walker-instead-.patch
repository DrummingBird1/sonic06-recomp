diff --git a/libs/video/cellGcmSys.c b/libs/video/cellGcmSys.c
index 84a424fb..36e8c8d6 100644
--- a/libs/video/cellGcmSys.c
+++ b/libs/video/cellGcmSys.c
@@ -1023,6 +1023,21 @@ static volatile u32 s_fifo_back_jumps = 0;
  * what the drain's own overrun recycle looks for; firing that under the
  * callback teleports get to begin and drops the tail the callback is waiting on. */
 static volatile int s_fifo_recycle_waiting = 0;
+/* A wrap that did not wait (cellGcm_fifo_recycle): the context's end is held at
+ * the walker's position in the tail, so the title writes from begin without
+ * reaching what the walker has not read. s_rec_limit_ctx is the context (0 =
+ * none), s_rec_limit_end the ring's real end, s_rec_limit_begin the IO offset
+ * the walker jumps back to. The walker gives the end back when it takes that
+ * jump (gcm_rec_limit_release). */
+static volatile u32 s_rec_limit_ctx = 0;
+static u32 s_rec_limit_end = 0, s_rec_limit_begin = 0;
+static void gcm_rec_limit_release(void)
+{
+    const u32 ctx = __atomic_load_n(&s_rec_limit_ctx, __ATOMIC_ACQUIRE);
+    if (!ctx) return;
+    vm_write32(ctx + 0x4, s_rec_limit_end);             /* end first: a waiter reads it after ctx clears */
+    __atomic_store_n(&s_rec_limit_ctx, 0u, __ATOMIC_RELEASE);
+}
 
 /* Bytes the walker is behind the writer. Linear while put >= get. Once the
  * title's ring wraps, put sits BEHIND get and the backlog is the rest of the
@@ -1633,6 +1648,7 @@ static void gcm_fifo_resync_why(const char* why, u32* getoff, u32 put)
     if (PS3_LOG_FIRST(n, 8))
         fprintf(stderr, "[cellGcmSys] FIFO resync (%s) 0x%08X -> put 0x%08X\n",
                 why, *getoff, put);
+    gcm_rec_limit_release();   /* the walker leaves any held tail too */
     /* If an SPU DMA'd a pushbuffer that ends just short of `put`, that is the
      * stream the RSX is being pointed at -- land at its START and walk it,
      * instead of landing on `put` and skipping it. Resyncing to `put` keeps the
@@ -1859,6 +1875,7 @@ void cellGcm_ref_on_poll(void)
 }
 
 static uint64_t s_ft_sema_t0;          /* PS3_FTRACE: when the walker began waiting on the current acquire */
+static u32 s_ft_drain_why, s_ft_drain_bytes;   /* PS3_FTRACE: why the last pass stopped, how far it went */
 
 /* RSX_WALKER_PROF=<file>: an in-process sampling profile of the FIFO walker
  * thread, for hosts where an external sampler cannot attach. Once
@@ -1987,12 +2004,13 @@ void cellGcm_rsx_process_fifo(void)
     g_gcm_drain_tid = GetCurrentThreadId();
     const uint64_t ft_t0 = PS3_FT_ON() ? ps3_ft_now() : 0;
     AcquireSRWLockExclusive(&s_gcm_fifo_lock);
+    s_ft_drain_why = s_ft_drain_bytes = 0;   /* a pass that returns early says 0 */
     gcm_rsx_process_fifo_unlocked();
     ReleaseSRWLockExclusive(&s_gcm_fifo_lock);
     if (ft_t0) {
         const uint64_t t1 = ps3_ft_now();
         if (t1 - ft_t0 >= ps3_ft_min_ns())
-            ps3_ft_span(PS3_FT_DRAIN, 0, s_ft_sema_t0 ? 1u : 0u, 0, ft_t0, t1);
+            ps3_ft_span(PS3_FT_DRAIN, 0, (s_ft_sema_t0 ? 1u : 0u) | (s_ft_drain_why << 4), s_ft_drain_bytes, ft_t0, t1);
     }
 }
 
@@ -2422,6 +2440,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
                   break;
               }
               if (tgt < s_fifo_getoff) s_fifo_back_jumps++;
+              if (s_rec_limit_ctx && tgt == s_rec_limit_begin) gcm_rec_limit_release();   /* the tail is read */
               s_fifo_getoff = tgt;
               /* get is the RSX's fetch pointer: a title polling it sees the
                * GPU leave a segment as soon as the JUMP out of it is taken.
@@ -2810,6 +2829,8 @@ static void gcm_rsx_process_fifo_unlocked(void)
             fprintf(stderr, "[DRAINEND] %s: %08X -> %08X (%u bytes), put=%08X\n",
                     why, start_off, s_fifo_getoff, s_fifo_getoff - start_off, put);
     }
+    s_ft_drain_why = !strcmp(why, "caught-up") ? 1u : !strcmp(why, "flip") ? 2u : !strcmp(why, "parked") ? 3u : 4u;
+    s_ft_drain_bytes = s_fifo_getoff - start_off;
     /* Recycle the TITLE'S OWN command buffer when its callback will not.
      *
      * gCellGcmCurrentContext points at the title's context, not the one
@@ -2875,7 +2896,7 @@ static void gcm_rsx_process_fifo_unlocked(void)
          * overruns first, so the first overrun is recycled by the path above
          * and near-end recycling is enabled from then on. */
         static int s_title_overran = 0;
-        if (s_fifo_recycle_waiting) head_consumed = 0;   /* its callback is recycling */
+        if (s_fifo_recycle_waiting || s_rec_limit_ctx) head_consumed = 0;   /* its callback is recycling */
         else if (begin && end > begin && cur >= end) { head_consumed = 1; s_title_overran = 1; }
         if (begin && end > begin && cur >= begin && cur + GCM_RECYCLE_SLACK >= end
                 && head_consumed && s_title_overran) {
@@ -2936,11 +2957,41 @@ static u32 gcm_ea2io(u32 ea)
     return ((u32)io_page << 20) | (ea & 0xFFFFFu);
 }
 
-void cellGcm_fifo_recycle(u32 ctx_ea)
+/* Room the walker keeps between itself and a title writing behind it. */
+#define GCM_REC_GUARD 0x1000u
+/* GCM_RECYCLE_WAIT=1: every wrap waits for the walker to read the whole tail,
+ * as before the end was held instead. */
+static int gcm_recycle_nowait(void)
+{
+    static int v = -1;
+    if (v < 0) v = getenv("GCM_RECYCLE_WAIT") ? 0 : 1;
+    return v;
+}
+
+void cellGcm_fifo_recycle(u32 ctx_ea, u32 count)
 {
     if (!ctx_ea) return;
     u32 begin   = vm_read32(ctx_ea + 0x0);
     u32 current = vm_read32(ctx_ea + 0x8);
+    if (count > 0x40000u) count = 0x40000u;             /* words; a bad value must not wrap the sums */
+
+    /* The end can have moved back out since the title read it. */
+    if (count && current + count * 4u <= vm_read32(ctx_ea + 0x4)) return;
+    /* The title reached the end a wrap held at the walker (below) before the
+     * walker left the old tail. Wait for it to leave, as a wrap used to, and
+     * then go on writing where the title is: the end it gets back is the
+     * ring's. A walker that stops moving gives the end back anyway. */
+    if (s_rec_limit_ctx == ctx_ea) {
+        int spins = 0, idle = 0;
+        u32 last_get = s_fifo_getoff;
+        while (__atomic_load_n(&s_rec_limit_ctx, __ATOMIC_ACQUIRE) == ctx_ea && idle < 2000 && spins < 60000) {
+            Sleep(1); spins++;
+            if (s_fifo_getoff != last_get) { last_get = s_fifo_getoff; idle = 0; }
+            else idle++;
+        }
+        gcm_rec_limit_release();
+        if (count && current + count * 4u <= vm_read32(ctx_ea + 0x4)) return;
+    }
     if (current <= begin) return;                       /* nothing to recycle */
 
     if (getenv("CELLMARK_BLINKDBG"))
@@ -2949,8 +3000,8 @@ void cellGcm_fifo_recycle(u32 ctx_ea)
     static int s_recdbg = -1;
     if (s_recdbg < 0) s_recdbg = getenv("GCM_RECDBG") ? 1 : 0;
     if (s_recdbg)
-        fprintf(stderr, "[REC>] tid=%lu begin=%08X cur=%08X put=%08X get=%08X drained=%08X\n",
-                GetCurrentThreadId(), begin, current,
+        fprintf(stderr, "[REC>] tid=%lu count=%u begin=%08X end=%08X cur=%08X put=%08X get=%08X drained=%08X\n",
+                GetCurrentThreadId(), count, begin, vm_read32(ctx_ea + 0x4), current,
                 vm_read32(GCM_CONTROL_GUEST_ADDR + 0),
                 vm_read32(GCM_CONTROL_GUEST_ADDR + 4),
                 g_gcm_fifo_drained_ea);
@@ -2963,6 +3014,32 @@ void cellGcm_fifo_recycle(u32 ctx_ea)
     const u32 back_jumps0 = s_fifo_back_jumps;
     if (io_begin != 0xFFFFFFFFu) {
         vm_write32(current, 0x20000000u | io_begin);            /* JUMP begin  */
+        /* Do not wait for the walker to read the tail. A title flushes `put`
+         * once a frame, so at a wrap the tail is most of a frame the walker
+         * has not been allowed to read yet, and waiting for it serialised the
+         * title with the walker: 2-35 ms once every 27 frames in Sonic the
+         * Hedgehog, a missed vblank each time. The SDK's callback only waits
+         * for the RSX to leave the room it is about to write, and the start of
+         * the ring was read a lap ago. Hold the end at the walker instead, so
+         * the title cannot write over what the walker has not read, and let
+         * the walker give it back when it takes the jump. The walker is only
+         * ever in the tail here: it cannot pass the old `put`, and the jump
+         * lies beyond it until `put` moves below. */
+        const u32 io_cur = gcm_ea2io(current), get = s_fifo_getoff;
+        const u32 need = count * 4u + 4u;                       /* the reserve, and a JUMP after it */
+        if (gcm_recycle_nowait() && !s_rec_limit_ctx && io_cur != 0xFFFFFFFFu &&
+                get >= io_begin + need + GCM_REC_GUARD && get <= io_cur) {
+            s_rec_limit_end = vm_read32(ctx_ea + 0x4);
+            s_rec_limit_begin = io_begin;
+            __atomic_store_n(&s_rec_limit_ctx, ctx_ea, __ATOMIC_RELEASE);
+            vm_write32(ctx_ea + 0x4, begin + ((get - io_begin - GCM_REC_GUARD) & ~3u));   /* end = the walker */
+            vm_write32(ctx_ea + 0x8, begin);                                              /* current = begin */
+            atomic_thread_fence(memory_order_release);
+            vm_write32(GCM_CONTROL_GUEST_ADDR + 0, io_begin);                             /* put = begin */
+            if (PS3_FT_ON()) { const uint64_t t = ps3_ft_now();
+                               ps3_ft_span(PS3_FT_RECYCLE, 0, 0, io_cur - get, t, t); }
+            return;
+        }
         /* The jump has to be in guest memory before `put` moves behind the
          * walker's `get`. Program order is not enough on arm64: the walker
          * may observe the new `put`, find `get` != `put`, and read the old
@@ -2985,6 +3062,8 @@ void cellGcm_fifo_recycle(u32 ctx_ea)
      * 60 s caps the whole thing. */
     int spins = 0, idle = 0;
     u32 last_get = s_fifo_getoff;
+    const uint64_t ft_r0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+    const u32 ft_tail = gcm_ea2io(current) - s_fifo_getoff;   /* unread bytes, when get is in the tail */
     s_fifo_recycle_waiting = 1;
     while (io_begin != 0xFFFFFFFFu && s_fifo_back_jumps == back_jumps0 &&
            idle < 2000 && spins < 60000) {
@@ -3005,6 +3084,7 @@ void cellGcm_fifo_recycle(u32 ctx_ea)
 
     vm_write32(ctx_ea + 0x8, begin);                    /* recycle ring to base */
     s_fifo_recycle_waiting = 0;                          /* current no longer reads end */
+    if (ft_r0) ps3_ft_span(PS3_FT_RECYCLE, 0, (u32)spins, ft_tail, ft_r0, ps3_ft_now());
 
     if (s_recdbg)
         fprintf(stderr, "[REC<] tid=%lu cur-now=%08X put=%08X get=%08X drained=%08X spins=%d\n",

+void ps3_ww_report_inline(uint32_t a, uint64_t v, int w) { (void)a; (void)v; (void)w; }
+int spu_coh_is_reserved(uint32_t a) { (void)a; return 0; }
+void spu_coh_notify_write(uint32_t a) { (void)a; }
+void spu_lockline_lock(void) {}
+void spu_lockline_unlock(void) {}
+ps3_guest_caller_fn g_ps3_guest_caller;
+/* The rest of the walker's world: no graphics backend, no lifted program. */
+PPU_THREAD_LOCAL ppu_context* g_active_ctx;
+u32 g_rsx_last_reference;
+void (*g_spu_put_hook)(uint32_t ea, uint32_t size);
+void rsx_raise_user_cmd(uint32_t arg) { (void)arg; }
+void ppu_dump_bctrl_ring(uint32_t n, const char* why) { (void)n; (void)why; }
+void ppu_dump_guest_stack(ppu_context* c, const char* why) { (void)c; (void)why; }
+void rsx_state_init(rsx_state* state) { (void)state; }
+int  rsx_process_method(rsx_state* state, u32 method, u32 data) { (void)state; (void)method; (void)data; return 0; }
+/* No microcode or constant runs here: the walker hands every word to
+ * rsx_process_method instead. */
+int  rsx_process_vp_run(rsx_state* state, u32 method, const u8* src, u32 count)
+{ (void)state; (void)method; (void)src; (void)count; return 0; }
+int  rsx_draw_engine_enabled(void) { return 0; }
+rsx_backend* rsx_get_backend(void) { return NULL; }
+void rsx_draw_engine_method(u32 method, u32 arg) { (void)method; (void)arg; }
+void rsx_draw_engine_note_flip(u32 buffer_id) { (void)buffer_id; }
+void rsx_draw_engine_guest_read(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+void rsx_draw_engine_guest_wrote(u32 l, u32 o, u32 p, u32 w, u32 h) { (void)l; (void)o; (void)p; (void)w; (void)h; }
+int  rsx_live_draw_enabled(void) { return 0; }
+void rsx_live_draw_method(u32 method, u32 arg) { (void)method; (void)arg; }
+int  rsx_live_draw_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 w, u32 h)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)w; (void)h; return 0; }
+void rsx_live_draw_note_resolve(u32 a, u32 b, u32 c, u32 d) { (void)a; (void)b; (void)c; (void)d; }
+int  rsx_live_draw_resolve_blit(u32 a, u32 b, u32 c, u32 d, u32 e, u32 f, u32 g, u32 h,
+                                u32 i, u32 j, u32 k, u32 l)
+{ (void)a; (void)b; (void)c; (void)d; (void)e; (void)f; (void)g; (void)h; (void)i; (void)j; (void)k; (void)l; return 0; }
+
+#define IO_ADDR   0x00100000u
+#define IO_SIZE   0x00400000u
+#define CMD_SIZE  0x00080000u
+
+static uint32_t g_heap = 0x00800000u;
+static u32 host_alloc(u32 size, u32 align)
+{
+    if (!align) align = 4;
+    g_heap = (g_heap + align - 1u) & ~(align - 1u);
+    u32 r = g_heap;
+    g_heap += size;
+    return r;
+}
+static void host_w32(u32 ea, u32 v) { vm_write32(ea, v); }
+
+static int fails;
+static void check(int ok, const char* what)
+{
+    printf("[%s] %s\n", ok ? "PASS" : "FAIL", what);
+    fails += !ok;
+}
+
+/* The title has written up to `cur`; the walker has read everything up to
+ * `get`, the last flush, and the words in between are NOPs. */
+static void fill(u32 rt, u32 ctrl, u32 get_ea, u32 cur)
+{
+    const u32 begin = vm_read32(rt);
+    for (u32 a = get_ea; a < cur + 8u; a += 4) vm_write32(a, 0);
+    vm_write32(rt + 8, cur);
+    s_fifo_getoff = gcm_ea2io(begin) + (get_ea - begin);
+    vm_write32(ctrl + 4, s_fifo_getoff);
+    vm_write32(ctrl + 0, s_fifo_getoff);
+}
+
+#ifdef _WIN32
+#pragma comment(lib, "winmm.lib")
+__declspec(dllimport) unsigned __stdcall timeBeginPeriod(unsigned);
+#endif
+
+int main(void)
+{
+    setvbuf(stdout, NULL, _IONBF, 0);
+#ifdef _WIN32
+    timeBeginPeriod(1);   /* Sleep(1) is a millisecond, as in the runtime, not a 15 ms tick */
+#endif
+    const uint32_t vm_size = ppu_hle_inject_base + 0x10000u;
+    vm_base = (uint8_t*)calloc(1, vm_size);
+    if (!vm_base) { puts("FAIL: guest VM alloc"); return 1; }
+    ppu_vm_size = vm_size;
+
+    u32 ctx_out = host_alloc(4, 4);
+    const u32 rt = cellGcmSetupContext(ctx_out, CMD_SIZE, IO_SIZE, IO_ADDR, host_alloc, host_w32);
+    const u32 ctrl = (u32)(uintptr_t)cellGcmGetControlRegister();
+    const u32 begin = vm_read32(rt), end = vm_read32(rt + 4), io_begin = gcm_ea2io(begin);
+    const u32 tail = begin + 0x30000u, cur = end - 0x100u;
+    const u32 big = 0x80;                      /* words: more than the 0x100 bytes left */
+
+    /* 1. The walker is in the tail: the wrap holds the end and returns. */
+    fill(rt, ctrl, tail, cur);
+    unsigned long long t0 = ps3_ms_now();
+    cellGcm_fifo_recycle(rt, big);
+    check(ps3_ms_now() - t0 < 50, "the wrap returns without waiting for the walker");
+    check(vm_read32(cur) == (0x20000000u | io_begin), "a JUMP to begin at the old write head");
+    check(vm_read32(rt + 8) == begin, "current is back at begin");
+    check(vm_read32(ctrl + 0) == io_begin, "put is begin");
+    check(vm_read32(rt + 4) == tail - GCM_REC_GUARD, "end is held short of the walker");
+    cellGcm_fifo_recycle(rt, 16);
+    check(vm_read32(rt + 8) == begin && vm_read32(rt + 4) == tail - GCM_REC_GUARD,
+          "a callback whose reserve fits changes nothing");
+    cellGcm_rsx_process_fifo();
+    check(s_fifo_getoff == io_begin, "the walker reads the tail, takes the jump and stops at put");
+    check(vm_read32(rt + 4) == end, "taking the jump gives the ring its end back");
+    check(s_rec_limit_ctx == 0, "nothing is held after that");
+
+    /* 2. The walker too close to begin to leave the title room: the old wait,
+     * which gives up after 2 s with no walker running here. */
+    fill(rt, ctrl, begin + 0x100u, cur);
+    t0 = ps3_ms_now();
+    cellGcm_fifo_recycle(rt, big);
+    check(ps3_ms_now() - t0 >= 1900, "with the walker near begin the wrap waits, as before");
+    check(vm_read32(rt + 4) == end && s_rec_limit_ctx == 0, "and holds nothing");
+    check(vm_read32(rt + 8) == begin, "current is back at begin after it");
+
+    /* 3. The title reaches the held end before the walker has moved: the
+     * callback waits for the walker (here: gives up after 2 s), gives the end
+     * back, and the title goes on where it is, without a second wrap. */
+    fill(rt, ctrl, tail, cur);
+    cellGcm_fifo_recycle(rt, big);
+    const u32 held = vm_read32(rt + 4), at = held - 8u;
+    vm_write32(rt + 8, at);
+    t0 = ps3_ms_now();
+    cellGcm_fifo_recycle(rt, big);
+    check(ps3_ms_now() - t0 >= 1900, "a title at the held end waits for the walker");
+    check(vm_read32(rt + 4) == end && s_rec_limit_ctx == 0, "then the ring's end is back");
+    check(vm_read32(rt + 8) == at && vm_read32(at) == 0, "and current stays put, with no JUMP written");
+
+    printf("[gcm_recycle_hold] %s (%d failed)\n", fails ? "FAIL" : "PASS", fails);
+    free(vm_base);
+    return fails ? 1 : 0;
+}

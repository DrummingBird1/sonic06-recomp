@@ -6520,15 +6526,19 @@ skip_dump_consider: ;
      * title past the display's rate. Skipped for an offscreen-only batch. */
     double _p0 = perf_on() ? perf_now() : 0.0;
     if (s_present_this_frame) {
+        const uint64_t ft_p0 = PS3_FT_ON() ? ps3_ft_now() : 0;
         if (!d3d12_vsync_off())

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Mon, 2 Nov 2026 00:28:03 +0200
Subject: [PATCH] cellAudio: consume blocks on the PS3 block clock, not in
 device bursts

The WASAPI loop mixed whatever the device had room for. With a 480-frame
shared-mode period and 256-frame blocks that consumed blocks in pairs a few
microseconds apart. Sonic 06's statically linked libmixer writes exactly one
block per notify event, into the slot the read index names at that moment,
with no lead; the second block of every pair was read before it could be
written. 7 of every 15 blocks played as silence and the music was chopped.

The mix thread now consumes one block every 5.333 ms on a high-resolution
waitable timer, and uses the device only to hold its buffer near a 6-block
fill (early below 4, late above 8, never sooner than half a period, as in
RPCS3). AUDIO_PACE=device restores the old loop for an A/B. AUDIO_RATE
reports the lowest device fill.

Title screen, same exe: silent blocks 46.7% -> 0.0%, AUDIO_WAV gaps
2623 -> 0. Wave Ocean 125 s: 1 gap. Story scene 110 s: 0 gaps.
No underruns in either mode.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/audio/cellAudio.c | 76 +++++++++++++++++++++++++++++++++---------
 1 file changed, 60 insertions(+), 16 deletions(-)

diff --git a/libs/audio/cellAudio.c b/libs/audio/cellAudio.c
index 02b751b2..ae5cbc81 100644
--- a/libs/audio/cellAudio.c
+++ b/libs/audio/cellAudio.c
@@ -561,6 +561,7 @@ static void audio_notify_event_queues(void)
 
 #ifdef _WIN32
 static unsigned long long g_audio_underruns;
+static u32 g_audio_fill_min = 0xFFFFFFFFu;   /* lowest device fill (frames) since the last AUDIO_RATE line */
 static unsigned __stdcall audio_mix_thread_func(void* arg)
 {
     (void)arg;
@@ -579,15 +580,42 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
       if (set_mm && !set_mm(L"Pro Audio", &task))
           fprintf(stderr, "[cellAudio] MMCSS Pro Audio unavailable (%lu)%c", (unsigned long)GetLastError(), 10); }
 
-    /* Pace to the device clock. The PS3 consumes one block every 5.33 ms;
-     * the old Sleep(2)/Sleep(5) loop keyed on a queue depth the 1056-frame
-     * WASAPI buffer can never reach, so it mixed ~225 blocks/s and the device
-     * dropped the surplus: 20% of the audio thrown away, and a guest mixer
-     * (GH3's FMOD) that could not keep ahead of the read index played gaps.
-     * With no device, pace on the performance counter instead. */
+    /* Pace on the PS3's own block clock: one block every 5.33 ms, evenly.
+     * Mixing whatever the device had room for consumed blocks in pairs
+     * microseconds apart (a 480-frame WASAPI period against 256-frame blocks),
+     * and a guest that writes the block the read index names when its event
+     * arrives -- Sonic 06's libmixer, with no lead -- had no time to write the
+     * second of a pair: 7 blocks in 15 played as silence, and the music was
+     * chopped. The device is the long-term reference only: its buffer is held
+     * near a target fill, the next block coming early below it (never sooner
+     * than half a period, RPCS3's minimum) and a little late above it.
+     * AUDIO_PACE=device restores the old loop, for an A/B. The very first
+     * loop (Sleep(2)/Sleep(5) on a queue depth the device buffer never
+     * reached) mixed ~225 blocks/s and lost 20% of the audio. */
     LARGE_INTEGER qf, q0; QueryPerformanceFrequency(&qf); QueryPerformanceCounter(&q0);
+    const long long period = qf.QuadPart * CELL_AUDIO_BLOCK_SAMPLES / CELL_AUDIO_SAMPLE_RATE;
+    const int device_paced = getenv("AUDIO_PACE") && !strcmp(getenv("AUDIO_PACE"), "device");
+    /* Waits of a few ms need a high-resolution timer: a plain one, like
+     * Sleep(1), ends on the 15.6 ms system tick. */
+    HANDLE tick = CreateWaitableTimerExW(NULL, NULL, 0x00000002 /* CREATE_WAITABLE_TIMER_HIGH_RESOLUTION */,
+                                         TIMER_ALL_ACCESS);
+    if (!tick) {
+        fprintf(stderr, "[cellAudio] no high-resolution timer (%lu); block pacing will be coarse%c",
+                (unsigned long)GetLastError(), 10);
+        tick = CreateWaitableTimerW(NULL, TRUE, NULL);
+    }
+    long long next = q0.QuadPart;
     unsigned long long blocks = 0;
     while (s_mix_thread_running) {
+        LARGE_INTEGER now; QueryPerformanceCounter(&now);
+        if (!device_paced && now.QuadPart < next) {
+            LARGE_INTEGER due; due.QuadPart = -(LONGLONG)((next - now.QuadPart) * 10000000 / qf.QuadPart);
+            if (tick && due.QuadPart < 0 && SetWaitableTimer(tick, &due, 0, NULL, NULL, FALSE))
+                WaitForSingleObject(tick, 50);
+            else
+                SwitchToThread();
+            continue;
+        }
         const int room = audio_backend_room();
         if (room >= 0 && room < CELL_AUDIO_BLOCK_SAMPLES) { audio_backend_wait(); continue; }
 #if AUDIO_BACKEND_WASAPI
@@ -595,17 +623,32 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
          * audible click/stutter). AUDIO_RATE reports how often. */
         if (room >= 0 && blocks > 64 &&
             (UINT32)room + CELL_AUDIO_BLOCK_SAMPLES / 2 >= s_wasapi_buf_frames) g_audio_underruns++;
+        if (room >= 0) {
+            const u32 fill = s_wasapi_buf_frames - (u32)room;
+            if (fill < g_audio_fill_min) g_audio_fill_min = fill;
+        }
 #endif
-        if (room < 0) {
-            LARGE_INTEGER now; QueryPerformanceCounter(&now);
-            const long long due = q0.QuadPart +
-                (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
+        if (device_paced && room < 0) {
+            const long long due = q0.QuadPart + (long long)blocks * period;
             if (now.QuadPart < due) { Sleep(1); continue; }
-            /* More than 50 ms behind (device just went away, a debugger
-             * stop): drop the backlog instead of mixing it in a burst. */
             if (now.QuadPart - due > qf.QuadPart / 20)
-                q0.QuadPart = now.QuadPart -
-                    (long long)(blocks * CELL_AUDIO_BLOCK_SAMPLES * qf.QuadPart / CELL_AUDIO_SAMPLE_RATE);
+                q0.QuadPart = now.QuadPart - (long long)blocks * period;
+        }
+        if (!device_paced) {
+            /* Target fill 6 blocks (32 ms), band 4..8. Without a device, the
+             * clock alone. */
+            long long step = period;
+#if AUDIO_BACKEND_WASAPI
+            if (room >= 0) {
+                const u32 fill = s_wasapi_buf_frames - (u32)room + CELL_AUDIO_BLOCK_SAMPLES;
+                if (fill < 4 * CELL_AUDIO_BLOCK_SAMPLES)      step = period / 2;
+                else if (fill > 8 * CELL_AUDIO_BLOCK_SAMPLES) step = period * 6 / 5;
+            }
+#endif
+            next += step;
+            /* Behind schedule (a stall, a debugger stop): keep the spacing
+             * rather than mixing the backlog in a burst. */
+            if (next < now.QuadPart + period / 2) next = now.QuadPart + period / 2;
         }
         blocks++;
         /* Mix and submit one block */
@@ -631,15 +674,16 @@ static unsigned __stdcall audio_mix_thread_func(void* arg)
             { int nz = 0; for (u32 i = 0; i < CELL_AUDIO_BLOCK_SAMPLES * 2; i++) if (s_mix_buffer[i] != 0.0f) { nz = 1; break; }
               if (!nz) z++; }
             if (now - t0 >= 5000) {
-                fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%, dropped %.0f frames/s, underruns %llu, device buf %u%c",
+                fprintf(stderr, "[audio-rate] %.1f blocks/s (real time 187.5), silent %.1f%%, dropped %.0f frames/s, underruns %llu, min fill %u, device buf %u%c",
                         n * 1000.0 / (now - t0), n ? 100.0 * z / n : 0.0, (g_audio_dropped - d0) * 1000.0 / (now - t0),
                         g_audio_underruns - u0,
+                        g_audio_fill_min == 0xFFFFFFFFu ? 0u : g_audio_fill_min,
                 #if AUDIO_BACKEND_WASAPI
                         (unsigned)s_wasapi_buf_frames, 10);
 #else
                         0u, 10);
 #endif
-                n = z = 0; d0 = g_audio_dropped; u0 = g_audio_underruns; t0 = now; } } }
+                n = z = 0; d0 = g_audio_dropped; u0 = g_audio_underruns; g_audio_fill_min = 0xFFFFFFFFu; t0 = now; } } }
 
         /* Notify event queues */
         audio_notify_event_queues();

 #include "rsx_vp_decompiler.h"
+extern u32 rsx_vp_program_size_instrs(const u8*, u32);
+extern int rsx_vp_decompile(const uint8_t*, u32, char*, u32);
+
+/* VP_START_OFF=1: decompile from instruction 0, not SET_TRANSFORM_PROGRAM_START. */
+static int vp_start_off(void)
+{
+    static int off = -1;
+    if (off < 0) off = getenv("VP_START_OFF") ? 1 : 0;
+    return off;
+}
+
+/* g_rsx_vp_prefetch: a program the FIFO read-ahead found a draw will run.
+ * The same bytes vp_get_vs will decompile -- from the program start to its end
+ * bit -- so the HLSL, and the cache key, come out the same; a new one goes to
+ * a worker. Programs already compiled, or offered lately, are skipped by their
+ * hash before anything is decompiled. */
+static void d3d12_vp_prefetch(const u8* store, u32 bytes, u32 start)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("D3D12_SHADER_PREFETCH");
+                  on = !(e && e[0] == '0') && !getenv("VP_W_ONE") && !getenv("VP_BYPASS"); }
+    if (!on || bytes < 16) return;
+    u32 vstart = vp_start_off() ? 0 : start * 16u;
+    if (vstart >= bytes) vstart = 0;
+    const u8* vuc = store + vstart;
+    u32 vlen = bytes - vstart;
+    const u32 instrs = rsx_vp_program_size_instrs(vuc, vlen);
+    if (instrs) vlen = instrs * 16u;
+    const u32 hash = vp_hash_ucode(vuc, vlen);
+    for (int i = 0; i < s_d3d.vp_vs_n; i++)
+        if (s_d3d.vp_vs[i].hash == hash) return;
+    static u32 offered[512], n_offered;
+    for (u32 i = 0; i < 512; i++)
+        if (offered[i] == hash) return;
+    offered[n_offered++ % 512] = hash;
+    static char hlsl[262144];
+    if (rsx_vp_decompile(vuc, vlen, hlsl, sizeof hlsl) <= 0) return;
+    { static int dbg = -1;
+      if (dbg < 0) dbg = getenv("D3D12_SHADER_CACHE_DBG") ? 1 : 0;
+      if (dbg) printf("[shader] read-ahead offers vp hash=%08X start=%u (%u instrs)\n", hash, start, instrs); }
+    shader_prefetch(hlsl, strlen(hlsl), "vs_5_0");
+}

index 6624e71b..f8ae1203 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -2382,25 +2382,135 @@ static int dxbc_whole(const u8* p, size_t n)

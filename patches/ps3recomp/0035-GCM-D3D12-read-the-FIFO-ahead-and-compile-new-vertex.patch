+static void shader_cache_write(const char* path, ID3DBlob* b)
+{
+    const u8* p = (const u8*)b->lpVtbl->GetBufferPointer(b);
+    const size_t n = b->lpVtbl->GetBufferSize(b);
+    char tmp[MAX_PATH + 96];
+    snprintf(tmp, sizeof tmp, "%s.%lu.tmp", path, (unsigned long)GetCurrentThreadId());
+    FILE* f = fopen(tmp, "wb");
+    if (!f) return;
+    const int ok = fwrite(p, 1, n, f) == n;
+    fclose(f);
+    if (!ok || !MoveFileExA(tmp, path, MOVEFILE_REPLACE_EXISTING)) DeleteFileA(tmp);
+}
+
+/* Compiles started ahead of the walker (d3d12_vp_prefetch, from the FIFO
+ * read-ahead in cellGcmSys.c), on the system thread pool. shader_compile waits
+ * for a program's job instead of compiling it a second time. Only the RSX
+ * thread starts jobs and takes their results; the lock covers the workers
+ * finishing. D3D12_SHADER_PREFETCH=0 turns the read-ahead off. */
+#define SHADER_JOBS 64
+typedef struct {
+    u64 key;
+    int state;                       /* 0 free, 1 compiling, 2 done */
+    HANDLE done;                     /* manual reset: set when state becomes 2 */
+    char* hlsl; size_t len;
+    char target[8];
+    char path[MAX_PATH + 64];
+    ID3DBlob* blob; HRESULT hr;
+} ShaderJob;
+static ShaderJob s_jobs[SHADER_JOBS];
+static SRWLOCK s_jobs_lock = SRWLOCK_INIT;
+
+static void CALLBACK shader_job_run(PTP_CALLBACK_INSTANCE inst, void* param)
+{
+    (void)inst;
+    ShaderJob* j = (ShaderJob*)param;
+    const uint64_t ft0 = PS3_FT_ON() ? ps3_ft_now() : 0;
+    ID3DBlob* b = NULL; ID3DBlob* e = NULL;
+    const HRESULT hr = D3DCompile(j->hlsl, j->len, "prefetch", NULL, NULL, "main", j->target,
+                                  shader_opt_flags(), 0, &b, &e);
+    if (e) e->lpVtbl->Release(e);
+    if (SUCCEEDED(hr) && b && j->path[0]) shader_cache_write(j->path, b);
+    if (ft0) ps3_ft_span(PS3_FT_COMPILE, 0, j->target[0] == 'v' ? 0u : 1u, 2u, ft0, ps3_ft_now());
+    AcquireSRWLockExclusive(&s_jobs_lock);
+    free(j->hlsl); j->hlsl = NULL;
+    j->blob = b; j->hr = hr; j->state = 2;
+    ReleaseSRWLockExclusive(&s_jobs_lock);
+    SetEvent(j->done);
+}
+
+static void shader_path(char* path, size_t cap, const char* dir, u64 key, const char* target)
+{
+    if (dir) snprintf(path, cap, "%s\\%016llx.%s.dxbc", dir, (unsigned long long)key, target);
+    else path[0] = 0;
+}
+
+/* Start compiling `hlsl` on a worker unless it is on disk or under way. */
+static void shader_prefetch(const char* hlsl, size_t len, const char* target)
+{
+    const char* dir = shader_cache_dir();
+    const u64 key = shader_key(hlsl, len, target, shader_opt_flags());
+    char path[MAX_PATH + 64];
+    shader_path(path, sizeof path, dir, key, target);
+    if (path[0] && GetFileAttributesA(path) != INVALID_FILE_ATTRIBUTES) return;
+    ShaderJob* j = NULL;
+    AcquireSRWLockExclusive(&s_jobs_lock);
+    for (int i = 0; i < SHADER_JOBS; i++)
+        if (s_jobs[i].state && s_jobs[i].key == key) { ReleaseSRWLockExclusive(&s_jobs_lock); return; }
+    for (int i = 0; i < SHADER_JOBS && !j; i++)
+        if (!s_jobs[i].state) j = &s_jobs[i];
+    for (int i = 0; i < SHADER_JOBS && !j; i++)                /* done and never asked for: it is on disk */
+        if (s_jobs[i].state == 2) {
+            j = &s_jobs[i];
+            if (j->blob) { j->blob->lpVtbl->Release(j->blob); j->blob = NULL; }
+        }
+    char* copy = j ? (char*)malloc(len + 1) : NULL;
+    if (!copy) { ReleaseSRWLockExclusive(&s_jobs_lock); return; }   /* every slot compiling */
+    memcpy(copy, hlsl, len); copy[len] = 0;
+    j->key = key; j->state = 1; j->hlsl = copy; j->len = len; j->blob = NULL; j->hr = E_PENDING;
+    snprintf(j->target, sizeof j->target, "%s", target);
+    snprintf(j->path, sizeof j->path, "%s", path);
+    if (!j->done) j->done = CreateEventA(NULL, TRUE, FALSE, NULL);
+    else ResetEvent(j->done);
+    ReleaseSRWLockExclusive(&s_jobs_lock);
+    if (!j->done || !TrySubmitThreadpoolCallback(shader_job_run, j, NULL)) {
+        AcquireSRWLockExclusive(&s_jobs_lock);
+        free(j->hlsl); j->hlsl = NULL; j->state = 0;
+        ReleaseSRWLockExclusive(&s_jobs_lock);
+    }
+}
+

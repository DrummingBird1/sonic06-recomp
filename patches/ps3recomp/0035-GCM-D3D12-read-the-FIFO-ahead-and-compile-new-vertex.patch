+/* Read-ahead for the backend's shader compiler (g_rsx_vp_prefetch).
+ *
+ * A title uploads each draw's vertex program right before the draw, so no
+ * program reaches the runtime earlier than the draw that needs it. A title
+ * flushes a whole frame at once, though, so when a pass starts every program
+ * the frame will run is already in the FIFO. This reads ahead from `get` to
+ * `put` with a shadow of the microcode store and offers each program a draw
+ * will run to the backend, which compiles the new ones on worker threads.
+ * Sonic the Hedgehog's story scene brings four new programs in at one cut,
+ * and compiled one after another as the walker reached them they stopped it
+ * for 257 ms. Read only: the walk itself is unchanged, and a program read
+ * wrongly here costs a wasted compile and nothing else. CALLs are followed one
+ * deep, as the walker follows them: Sonic builds every draw, its program upload
+ * included, in a buffer of its own that the ring CALLs. */
+void (*g_rsx_vp_prefetch)(const u8* store, u32 bytes, u32 start) = NULL;
+static unsigned s_pf_calls;   /* GCM_PREFETCH_DBG: CALLs the read-ahead followed */
+
+static void gcm_vp_prefetch_scan(const rsx_state* st, u32 put)
+{
+    static u8  shadow[sizeof st->vp_ucode];
+    static u32 at = 0xFFFFFFFFu, cursor, bytes, start;   /* the scan's own state at `at` */
+    if (!g_rsx_vp_prefetch || put == at) return;
+    /* Go on from where the last scan stopped while the walker has not passed
+     * it; otherwise start again at the walker, from its state. */
+    const u32 get = s_fifo_getoff;
+    if (at == 0xFFFFFFFFu || gcm_fifo_backlog(at, get) > gcm_fifo_backlog(put, get)) {
+        memcpy(shadow, st->vp_ucode, sizeof shadow);
+        at = get;
+        cursor = st->vp_ucode_write; bytes = st->vp_ucode_bytes; start = st->transform_program_start;
+    }
+    int dirty = 1;
+    u32 off = at, steps = 0, ret = 0;
+    while (off != put && steps++ < 0x400000u) {
+        const u32 ea = gcm_io2ea(off);
+        if (!ea) break;
+        const u32 w = vm_read32(ea);
+        if ((w >> 29) == 1u) {                                  /* JUMP, as the walker reads it */
+            const u32 tgt = w & 0x1FFFFFFCu;
+            if (tgt == off || !gcm_io2ea(tgt)) break;           /* a park, or nowhere */
+            off = tgt;
+            continue;
+        }
+        if ((w & 3u) == 2u) {                                   /* CALL, one deep */
+            const u32 tgt = w & 0x1FFFFFFCu;
+            if (ret || !gcm_io2ea(tgt)) break;
+            ret = off + 4; off = tgt; s_pf_calls++;
+            continue;
+        }
+        if (w == 0x00020000u) {                                 /* RET */
+            if (!ret) break;
+            off = ret; ret = 0;
+            continue;
+        }
+        const u32 type = w >> 29;
+        if (type != 0 && type != 2) break;
+        const u32 count = (w >> 18) & 0x7FFu, method = w & 0x1FFCu, subch = (w >> 13) & 7u;
+        const u32 last = type == 0 ? method + (count ? count - 1 : 0) * 4 : method;
+        /* Only the methods that matter here are read: the program words
+         * (0x0B80-0x0BFC), its load slot (0x1E9C) and start (0x1EA0), and
+         * SET_BEGIN_END (0x1808) with a primitive, where a draw begins. */
+        if (subch <= 1 && count && !(last < 0x0B80u || (method > 0x0BFCu && last < 0x1808u) ||
+                                     (method > 0x1808u && last < 0x1E9Cu) || method > 0x1EA0u)) {
+            for (u32 i = 0; i < count; i++) {
+                const u32 m = type == 0 ? method + i * 4 : method;
+                if (!(m >= 0x0B80u && m < 0x0C00u) && m != 0x1E9Cu && m != 0x1EA0u && m != 0x1808u) continue;
+                const u32 dea = gcm_io2ea(off + 4 + i * 4);
+                if (!dea) break;
+                const u32 v = vm_read32(dea);
+                if (m == 0x1E9Cu) cursor = v * 16u;
+                else if (m == 0x1EA0u) { if (start != v) dirty = 1; start = v; }
+                else if (m == 0x1808u) { if (v && dirty) { g_rsx_vp_prefetch(shadow, bytes, start); dirty = 0; } }
+                else if (cursor + 4 <= sizeof shadow) {          /* as rsx_vp_ucode_word stores it */
+                    const u8 b[4] = { (u8)v, (u8)(v >> 8), (u8)(v >> 16), (u8)(v >> 24) };
+                    if (memcmp(shadow + cursor, b, 4)) { memcpy(shadow + cursor, b, 4); dirty = 1; }
+                    cursor += 4;
+                    if (cursor > bytes) bytes = cursor;
+                }
+            }
+        }
+        off += 4 + count * 4;
+    }
+    /* GCM_PREFETCH_DBG=1: what the read-ahead covered, every 300 passes. */
+    { static int dbg = -1; static unsigned passes;
+      if (dbg < 0) dbg = getenv("GCM_PREFETCH_DBG") ? 1 : 0;
+      if (dbg && passes++ % 300 == 0)
+          fprintf(stderr, "[prefetch] pass %u: get=%08X put=%08X scanned to %08X in %u words, cursor=%u bytes=%u start=%u calls=%u%c",
+                  passes, get, put, off, steps, cursor, bytes, start, s_pf_calls, 10); }
+    at = ret ? 0xFFFFFFFFu : off;   /* stopped inside a CALL: start again next time */
+}

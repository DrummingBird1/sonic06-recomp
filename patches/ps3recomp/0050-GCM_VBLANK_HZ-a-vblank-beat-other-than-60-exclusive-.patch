From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 22 Nov 2026 11:49:36 +0200
Subject: [PATCH] GCM_VBLANK_HZ: a vblank beat other than 60; exclusive
 fullscreen focus log

GCM_VBLANK_HZ=<30..240> sets the vblank and flip beat (60 by default, as
on the console), so a title that paces its frames on vblank or flip
handler calls can go above 60 when it keeps its own time. Sonic 06 at 120
with its variable step kept real time in a Wave Ocean run (24.93 game
seconds in 25).

The exclusive fullscreen window procedure now logs focus lost and back,
and whether fullscreen was still on when the window came back.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/video/rsx_d3d12_backend.c  |  6 +++++-
 runtime/ppu/tests/boot_main.cpp | 22 +++++++++++++++++++---
 2 files changed, 24 insertions(+), 4 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index cc053279..559d85a8 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -801,6 +801,7 @@ static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
         /* Alt+Tab took exclusive fullscreen away (DXGI leaves it on its own);
          * back in front, the next present enters it again. */
         if (s_d3d.exclusive) {
+            printf("[D3D12] exclusive fullscreen: window %s\n", wp ? "in front again" : "lost focus");
             if (wp) InterlockedExchange(&s_d3d.fs_retry, 1);
             else InterlockedExchange(&s_d3d.fs_on, 0);
         }
@@ -5548,7 +5549,10 @@ static void pp_resize_if_needed(void)
             HRESULT fh = s_d3d.swap_chain->lpVtbl->SetFullscreenState(s_d3d.swap_chain, TRUE, NULL);
             printf("[D3D12] exclusive fullscreen again: %s (0x%08lX)\n", SUCCEEDED(fh) ? "on" : "refused", fh);
             if (SUCCEEDED(fh)) { InterlockedExchange(&s_d3d.fs_on, 1); force = 1; }
-        } else InterlockedExchange(&s_d3d.fs_on, 1);
+        } else {
+            InterlockedExchange(&s_d3d.fs_on, 1);
+            printf("[D3D12] exclusive fullscreen: still on when the window came back\n");
+        }
     }
     const LONG w = s_pp.want_w, h = s_pp.want_h;
     if (w <= 0 || h <= 0 || (!force && (u32)w == s_pp.sc_w && (u32)h == s_pp.sc_h)) return;
diff --git a/runtime/ppu/tests/boot_main.cpp b/runtime/ppu/tests/boot_main.cpp
index 752817d0..dd58335b 100644
--- a/runtime/ppu/tests/boot_main.cpp
+++ b/runtime/ppu/tests/boot_main.cpp
@@ -470,6 +470,22 @@ static void tick_stats(unsigned long long due, int nth)
     }
 }
 
+/* GCM_VBLANK_HZ=<30..240>: the vblank and flip beat, 60 by default as on the
+ * console. A title that paces its frames on vblank or flip handler calls runs
+ * at most this many frames a second; above 60 it needs its own timing to
+ * follow real time, or it runs fast. Read once. */
+static unsigned long long vblank_hz(void)
+{
+    static unsigned long long hz = 0;
+    if (!hz) {
+        const char* e = getenv("GCM_VBLANK_HZ");
+        long v = e ? strtol(e, nullptr, 10) : 60;
+        hz = (unsigned long long)(v >= 30 && v <= 240 ? v : 60);
+        if (hz != 60) fprintf(stderr, "[gcm] vblank at %llu Hz (GCM_VBLANK_HZ)\n", hz);
+    }
+    return hz;
+}
+
 /* The 60 Hz vblank on a thread of its own (Windows; GCM_VBLANK_THREAD=0 puts
  * it back in vblank_ticker). In the ticker it shared a thread with the FIFO
  * drain and present: in Sonic 06's first scene half the ticks fired more than
@@ -496,7 +512,7 @@ static DWORD WINAPI vblank_clock(LPVOID)
     if (!t) t = CreateWaitableTimerW(NULL, TRUE, NULL);
     unsigned long long t0 = ps3_qpc_us(), k = 0;
     for (;;) {
-        const unsigned long long due = t0 + k * 1000000ull / 60, now = ps3_qpc_us();
+        const unsigned long long due = t0 + k * 1000000ull / vblank_hz(), now = ps3_qpc_us();
         if (now < due) {
             LARGE_INTEGER d;
             d.QuadPart = -(LONGLONG)((due - now) * 10);
@@ -571,9 +587,9 @@ static DWORD WINAPI vblank_ticker(LPVOID)
         cellGcm_fifo_kick_wait((unsigned)s_tick_ms);
         unsigned long long now = ps3_qpc_us();
         int fired = 0;
-        while (now >= tick_t0 + tick_k * 1000000ull / 60 && fired < 240) {
+        while (now >= tick_t0 + tick_k * 1000000ull / vblank_hz() && fired < 240) {
             if (!vblank_threaded()) {
-                tick_stats(tick_t0 + tick_k * 1000000ull / 60, fired);
+                tick_stats(tick_t0 + tick_k * 1000000ull / vblank_hz(), fired);
                 cellGcmTickVBlank();
             }
             cellGcmTickFlip();

+  #undef PAD_SDL_RESOLVE
+      if (missing) { FreeLibrary(m); printf("[cellPad] SDL2.dll unusable: XInput\n"); return 0; }
+      printf("[cellPad] SDL2 from %ls\n", path);
+      return 1;
+  }
+  #define SDL_GameControllerClose          p_SDL_GameControllerClose
+  #define SDL_GameControllerGetAttached    p_SDL_GameControllerGetAttached
+  #define SDL_GameControllerGetAxis        p_SDL_GameControllerGetAxis
+  #define SDL_GameControllerGetButton      p_SDL_GameControllerGetButton
+  #define SDL_GameControllerHasRumble      p_SDL_GameControllerHasRumble
+  #define SDL_GameControllerName           p_SDL_GameControllerName
+  #define SDL_GameControllerOpen           p_SDL_GameControllerOpen
+  #define SDL_GameControllerRumble         p_SDL_GameControllerRumble
+  #define SDL_GameControllerUpdate         p_SDL_GameControllerUpdate
+  #define SDL_GetError                     p_SDL_GetError
+  #define SDL_InitSubSystem                p_SDL_InitSubSystem
+  #define SDL_IsGameController             p_SDL_IsGameController
+  #define SDL_JoystickGetDeviceGUID        p_SDL_JoystickGetDeviceGUID
+  #define SDL_JoystickGetDeviceInstanceID  p_SDL_JoystickGetDeviceInstanceID
+  #define SDL_NumJoysticks                 p_SDL_NumJoysticks
+  #define SDL_PeepEvents                   p_SDL_PeepEvents
+  #define SDL_SetHint                      p_SDL_SetHint
+  #define SDL_WasInit                      p_SDL_WasInit
+  #define PAD_SDL_ACTIVE s_sdl_on
+#elif PAD_BACKEND_SDL2
   #include <SDL2/SDL.h>

+    X(SDL_WasInit)
+  #define PAD_SDL_PTR(fn) static __typeof__(&fn) p_##fn;
+  PAD_SDL_FNS(PAD_SDL_PTR)
+  #undef PAD_SDL_PTR
+  static int s_sdl_on;   /* SDL2.dll loaded and its game controller subsystem up */
+
+  /* SDL2.dll next to the exe, or PAD_SDL2_DLL; PAD_SDL2=0 keeps XInput. */
+  static int pad_sdl_load(void)
+  {
+      const char* off = getenv("PAD_SDL2");
+      if (off && !strcmp(off, "0")) { printf("[cellPad] PAD_SDL2=0: XInput\n"); return 0; }
+      wchar_t path[MAX_PATH];
+      const char* over = getenv("PAD_SDL2_DLL");
+      if (over && *over) MultiByteToWideChar(CP_UTF8, 0, over, -1, path, MAX_PATH);
+      else {
+          DWORD n = GetModuleFileNameW(NULL, path, MAX_PATH);
+          while (n > 0 && path[n - 1] != L'\\' && path[n - 1] != L'/') n--;
+          if (n == 0 || n + 9 >= MAX_PATH) return 0;
+          wcscpy(path + n, L"SDL2.dll");
+      }
+      HMODULE m = LoadLibraryExW(path, NULL, LOAD_WITH_ALTERED_SEARCH_PATH);
+      if (!m) { printf("[cellPad] no SDL2.dll (%ls): XInput, Xbox-style pads only\n", path); return 0; }
+      int missing = 0;
+  #define PAD_SDL_RESOLVE(fn) \

+#if PAD_SDL2_DYNAMIC
+                s_sdl_on = 0;   /* XInput instead */
+                return;
+#endif
+            }
         }
         s_sdl_inited = 1;
     }
@@ -666,7 +683,7 @@ static void pad_init_backend(void)
     pad_sdl_hotplug(1);
 }
 
-static void pad_shutdown_backend(void)
+static void pad_sdl2_shutdown(void)
 {
     for (int i = 0; i < PAD_MAX_HOST_PORTS; i++) pad_sdl_close(i, 0);
     memset(s_rumble, 0, sizeof s_rumble);
@@ -674,6 +691,282 @@ static void pad_shutdown_backend(void)
 
 #endif /* PAD_BACKEND_SDL2 */
 
+static void pad_init_backend(void)
+{
+#if PAD_SDL2_DYNAMIC
+    pad_sdl2_init();
+    if (!s_sdl_on) pad_xinput_init();
+#elif PAD_BACKEND_XINPUT
+    pad_xinput_init();
+#elif PAD_BACKEND_SDL2
+    pad_sdl2_init();
+#endif
+}
+
+static void pad_shutdown_backend(void)
+{
+#if PAD_SDL2_DYNAMIC
+    if (s_sdl_on) pad_sdl2_shutdown(); else pad_xinput_shutdown();
+#elif PAD_BACKEND_XINPUT
+    pad_xinput_shutdown();
+#elif PAD_BACKEND_SDL2
+    pad_sdl2_shutdown();
+#endif
+}
+
+/* ---------------------------------------------------------------------------
+ * Keyboard and mouse for port 0 (Windows)
+ *
+ * The keyboard fills in for port 0 when no controller is there, so on a
+ * machine with no controller plugged in a title is still playable (The
+ * Simpsons Arcade Game reached its attract loop and no input existed to start
+ * a game). A real controller always wins. Keys and mouse buttons are read only
+ * while a window of THIS process is in the foreground, so typing in another
+ * application does not drive the game. PAD_NO_KEYBOARD=1 turns it off.
+ *
+ * PAD_KEYS=<control>=<vk>[+<vk>],... replaces the whole map with Windows
+ * virtual-key codes, two per control at most; a control it leaves out has no
+ * key. Mouse buttons are virtual keys too (1 left, 2 right, 4 middle, 5 and 6
+ * the side buttons). The controls are up/down/left/right (the d-pad, and the
+ * left stick with it, so a title that reads either is playable), cam_up/
+ * cam_down/cam_left/cam_right (the right stick), cross, circle, square,
+ * triangle, l1, r1, l2, r2, l3, r3, start and select. Without PAD_KEYS:
+ * arrows, Z/X/A/S = cross/circle/square/triangle, Q/W = L1/R1, 1/2 = L2/R2,
+ * Enter = START, Tab = SELECT.
+ *
+ * PAD_MOUSE=<1..100> makes the mouse the right stick, with that sensitivity:
+ * while the game window has the focus the cursor is hidden and held at the
+ * centre of the window, and how fast it moves away from there is how far the
+ * stick is pushed. A camera key that is held wins over the mouse.
+ * -----------------------------------------------------------------------*/
+
+#ifdef _WIN32
+enum { K_UP, K_DOWN, K_LEFT, K_RIGHT, K_CAM_UP, K_CAM_DOWN, K_CAM_LEFT, K_CAM_RIGHT,
+       K_CROSS, K_CIRCLE, K_SQUARE, K_TRIANGLE, K_L1, K_R1, K_L2, K_R2, K_L3, K_R3,
+       K_START, K_SELECT, K_COUNT };
+static const char* const k_names[K_COUNT] = {
+    "up", "down", "left", "right", "cam_up", "cam_down", "cam_left", "cam_right",
+    "cross", "circle", "square", "triangle", "l1", "r1", "l2", "r2", "l3", "r3",
+    "start", "select" };
+static const u16 k_buttons[K_COUNT] = {
+    CELL_PAD_CTRL_UP, CELL_PAD_CTRL_DOWN, CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_RIGHT, 0, 0, 0, 0,
+    CELL_PAD_CTRL_CROSS, CELL_PAD_CTRL_CIRCLE, CELL_PAD_CTRL_SQUARE, CELL_PAD_CTRL_TRIANGLE,
+    CELL_PAD_CTRL_L1, CELL_PAD_CTRL_R1, CELL_PAD_CTRL_L2, CELL_PAD_CTRL_R2,
+    CELL_PAD_CTRL_L3, CELL_PAD_CTRL_R3, CELL_PAD_CTRL_START, CELL_PAD_CTRL_SELECT };
+static u8 s_keys[K_COUNT][2];   /* virtual keys, 0 = none */
+
+static void pad_keys_load(void)
+{
+    memset(s_keys, 0, sizeof s_keys);
+    const char* e = getenv("PAD_KEYS");
+    if (!e || !*e) {
+        static const u8 dflt[K_COUNT] = { VK_UP, VK_DOWN, VK_LEFT, VK_RIGHT, 0, 0, 0, 0,
+            'Z', 'X', 'A', 'S', 'Q', 'W', '1', '2', 0, 0, VK_RETURN, VK_TAB };
+        for (int k = 0; k < K_COUNT; k++) s_keys[k][0] = dflt[k];
+        return;
+    }
+    int bound = 0;
+    for (const char* p = e; *p; ) {
+        const char* eq = strchr(p, '=');
+        const char* end = strchr(p, ',');
+        if (!end) end = p + strlen(p);
+        if (eq && eq < end) {
+            int k = 0;
+            while (k < K_COUNT && !(strlen(k_names[k]) == (size_t)(eq - p) && !strncmp(p, k_names[k], (size_t)(eq - p)))) k++;
+            const char* v = eq + 1;
+            for (int slot = 0; k < K_COUNT && slot < 2 && v < end; slot++) {
+                char* stop;
+                long vk = strtol(v, &stop, 0);
+                if (stop == v) break;
+                if (vk > 0 && vk < 256) { s_keys[k][slot] = (u8)vk; bound++; }
+                v = (*stop == '+') ? stop + 1 : end;
+            }
+            if (k == K_COUNT) printf("[cellPad] PAD_KEYS: no control '%.*s'\n", (int)(eq - p), p);
+        }
+        p = *end ? end + 1 : end;
+    }
+    printf("[cellPad] PAD_KEYS: %d keys bound\n", bound);
+}
+
+static int pad_key_down(int k)
+{
+    for (int slot = 0; slot < 2; slot++)
+        if (s_keys[k][slot] && (GetAsyncKeyState(s_keys[k][slot]) & 0x8000)) return 1;
+    return 0;
+}
+
+static int pad_host_window_focused(void)
+{
+    HWND fg = GetForegroundWindow();
+    if (!fg) return 0;
+    DWORD pid = 0;
+    GetWindowThreadProcessId(fg, &pid);
+    return pid == GetCurrentProcessId();
+}
+
+/* ---- the mouse as the right stick ------------------------------------- */
+static int     s_mouse_sens = -1;   /* PAD_MOUSE, 0 = off */
+static HWND    s_mouse_hwnd;        /* the window whose cursor is hidden */
+static HCURSOR s_mouse_old_cursor, s_mouse_blank;
+static unsigned long long s_mouse_ms;   /* when s_mouse_ref was taken, 0 = not yet */
+static POINT   s_mouse_ref;         /* the cursor at the last poll */
+static float   s_mouse_x, s_mouse_y;   /* smoothed stick, -1..1 */
+static unsigned long long s_mouse_moved_ms;   /* the last poll that saw a motion */
+#define PAD_MOUSE_HOLD_MS 50
+static int     s_mouse_dbg;         /* PAD_MOUSE_DEBUG */
+
+/* The window class's cursor is what DefWindowProc shows on WM_SETCURSOR, so a
+ * blank one there hides the cursor over the game from this (non-window)
+ * thread; the old one goes back when the focus leaves. */
+static void pad_mouse_release(void)
+{
+    if (s_mouse_hwnd) {
+        SetClassLongPtrW(s_mouse_hwnd, GCLP_HCURSOR, (LONG_PTR)s_mouse_old_cursor);
+        ClipCursor(NULL);
+        s_mouse_hwnd = NULL;
+    }
+    s_mouse_ms = 0;
+    s_mouse_x = s_mouse_y = 0;
+}
+
+static void pad_mouse_poll(HWND fg, PadHostState* hs)
+{
+    RECT rc;
+    if (!GetClientRect(fg, &rc) || rc.right < 16 || rc.bottom < 16) { pad_mouse_release(); return; }
+    if (s_mouse_hwnd != fg) {
+        pad_mouse_release();
+        if (!s_mouse_blank) {
+            BYTE and_mask[128], xor_mask[128];   /* 32x32, 1 bit a pixel: all transparent */
+            memset(and_mask, 0xFF, sizeof and_mask);
+            memset(xor_mask, 0, sizeof xor_mask);
+            s_mouse_blank = CreateCursor(GetModuleHandleW(NULL), 0, 0, 32, 32, and_mask, xor_mask);
+        }
+        s_mouse_old_cursor = (HCURSOR)GetClassLongPtrW(fg, GCLP_HCURSOR);
+        SetClassLongPtrW(fg, GCLP_HCURSOR, (LONG_PTR)s_mouse_blank);
+        s_mouse_hwnd = fg;
+        printf("[cellPad] mouse look on (sensitivity %d)\n", s_mouse_sens);
+        fflush(stdout);
+    }
+    /* The motion is the cursor's own, between two reads. Moving it back to
+     * the centre on every poll made the camera turn by itself: with display
+     * scaling a SetCursorPos lands a few pixels from where the next read puts
+     * it, and that read as the mouse moving all the time. Now the cursor goes
+     * back to the centre only when it nears an edge, and the poll after that
+     * starts a new measurement. It is also kept inside the window. */
+    POINT c = { rc.right / 2, rc.bottom / 2 }, p;
+    ClientToScreen(fg, &c);
+    RECT sr = rc;
+    MapWindowPoints(fg, NULL, (POINT*)&sr, 2);
+    ClipCursor(&sr);
+    GetCursorPos(&p);
+    const unsigned long long now = pad_now_ms();
+    const unsigned long long dt = s_mouse_ms ? now - s_mouse_ms : 0;
+    float fx = 0, fy = 0;
+    if (dt > 0 && dt < 200) {
+        /* Pixels a millisecond, times the sensitivity: at 50, 1 px/ms (a
+         * brisk flick) is the stick pushed all the way. */
+        const float k = (float)s_mouse_sens * 0.02f / (float)dt;
+        fx = (float)(p.x - s_mouse_ref.x) * k;
+        fy = (float)(p.y - s_mouse_ref.y) * k;
+        /* PAD_MOUSE_DEBUG=1: every motion and every stick value, with GetTickCount64. */
+        { static int n = 0;
+          if ((p.x != s_mouse_ref.x || p.y != s_mouse_ref.y) && (s_mouse_dbg || PS3_LOG_FIRST(n, 3)))
+              printf("[cellPad] mouse look: moved %ld,%ld in %llu ms (tick %llu)\n",
+                     (long)(p.x - s_mouse_ref.x), (long)(p.y - s_mouse_ref.y), dt, now); }
+    }
+    s_mouse_ref = p;
+    s_mouse_ms = now;
+    const long qx = (rc.right - rc.left) / 4, qy = (rc.bottom - rc.top) / 4;
+    if (p.x < sr.left + qx || p.x > sr.right - qx || p.y < sr.top + qy || p.y > sr.bottom - qy) {
+        SetCursorPos(c.x, c.y);
+        s_mouse_ms = 0;
+    }
+    /* The mouse reports about every 16 ms, and the pad is polled more often
+     * than that, so most polls in the middle of a motion see none: the stick
+     * keeps its value for PAD_MOUSE_HOLD_MS after the last motion, then
+     * returns to the centre. Halving it on every empty poll instead swung it
+     * between about half and all of the way (69, 39, 84, 47, 88 in a test). */
+    if (fx || fy) {
+        s_mouse_x = s_mouse_x * 0.4f + fx * 0.6f;
+        s_mouse_y = s_mouse_y * 0.4f + fy * 0.6f;
+        s_mouse_moved_ms = now;
+    } else if (now - s_mouse_moved_ms > PAD_MOUSE_HOLD_MS) {
+        s_mouse_x *= 0.5f;
+        s_mouse_y *= 0.5f;
+    }
+    if (s_mouse_x > 1) s_mouse_x = 1; else if (s_mouse_x < -1) s_mouse_x = -1;
+    if (s_mouse_y > 1) s_mouse_y = 1; else if (s_mouse_y < -1) s_mouse_y = -1;
+    if (s_mouse_x > -0.02f && s_mouse_x < 0.02f) s_mouse_x = 0;
+    if (s_mouse_y > -0.02f && s_mouse_y < 0.02f) s_mouse_y = 0;
+    hs->analog_rx = (u8)(128 + (int)(s_mouse_x * 127.0f));
+    hs->analog_ry = (u8)(128 + (int)(s_mouse_y * 127.0f));
+    { static int n = 0;
+      if ((s_mouse_x || s_mouse_y) && (s_mouse_dbg || PS3_LOG_FIRST(n, 5))) {
+          printf("[cellPad] mouse look: right stick %u,%u (tick %llu)\n", hs->analog_rx, hs->analog_ry, now);
+          fflush(stdout); } }
+}

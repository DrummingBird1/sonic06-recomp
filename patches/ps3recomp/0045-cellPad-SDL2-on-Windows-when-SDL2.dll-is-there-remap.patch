   #include <xinput.h>
 #endif
 
-#if PAD_BACKEND_SDL2
+#if PAD_SDL2_DYNAMIC
+  /* The same reason as XInput: the exe does not import SDL2.dll, and starts
+   * without it. Every SDL function used below goes through a pointer that
+   * pad_sdl_load() fills from the DLL; one left out of PAD_SDL_FNS shows up as
+   * an unresolved SDL_ symbol at link time, since no SDL2.lib is linked. */
+  #define SDL_MAIN_HANDLED
+  #include <SDL.h>
+  #define PAD_SDL_FNS(X) \
+    X(SDL_GameControllerClose) X(SDL_GameControllerGetAttached) X(SDL_GameControllerGetAxis) \
+    X(SDL_GameControllerGetButton) X(SDL_GameControllerHasRumble) X(SDL_GameControllerName) \

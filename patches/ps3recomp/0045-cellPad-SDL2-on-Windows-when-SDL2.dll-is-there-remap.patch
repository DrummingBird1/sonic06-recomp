+static void pad_poll_keyboard(void)
+{
+    static int off = -1;
+    if (off < 0) {
+        off = getenv("PAD_NO_KEYBOARD") ? 1 : 0;
+        pad_keys_load();
+        const char* m = getenv("PAD_MOUSE");
+        s_mouse_sens = m ? atoi(m) : 0;
+        s_mouse_dbg = getenv("PAD_MOUSE_DEBUG") ? 1 : 0;
+        if (s_mouse_sens < 0) s_mouse_sens = 0;
+        if (s_mouse_sens > 100) s_mouse_sens = 100;
+    }
+    if (off) return;
+
+    PadHostState* hs = &s_host_state[0];
+    hs->connected = 1;
+    if (!pad_host_window_focused()) {
+        /* Release everything on focus loss, or a key held while alt-tabbing
+         * would stay down forever; the cursor comes back too. */
+        hs->buttons = 0;
+        hs->analog_lx = hs->analog_ly = 128;
+        hs->analog_rx = hs->analog_ry = 128;
+        hs->trigger_l2 = hs->trigger_r2 = 0;
+        pad_mouse_release();
+        return;
+    }
+
+    u16 btns = 0;
+    int held[K_COUNT];
+    for (int k = 0; k < K_COUNT; k++) {
+        held[k] = pad_key_down(k);
+        if (held[k]) btns |= k_buttons[k];
+    }
+
+    hs->buttons   = btns;
+    hs->analog_lx = (u8)(held[K_LEFT] ? 0 : held[K_RIGHT] ? 255 : 128);
+    hs->analog_ly = (u8)(held[K_UP] ? 0 : held[K_DOWN] ? 255 : 128);
+    hs->analog_rx = hs->analog_ry = 128;
+    if (s_mouse_sens > 0) pad_mouse_poll(GetForegroundWindow(), hs);
+    if (held[K_CAM_LEFT] || held[K_CAM_RIGHT]) hs->analog_rx = (u8)(held[K_CAM_LEFT] ? 0 : 255);
+    if (held[K_CAM_UP] || held[K_CAM_DOWN])    hs->analog_ry = (u8)(held[K_CAM_UP] ? 0 : 255);
+    hs->trigger_l2 = (u8)((btns & CELL_PAD_CTRL_L2) ? 255 : 0);
+    hs->trigger_r2 = (u8)((btns & CELL_PAD_CTRL_R2) ? 255 : 0);
+    hs->press_up       = (btns & CELL_PAD_CTRL_UP)       ? 255 : 0;
+    hs->press_down     = (btns & CELL_PAD_CTRL_DOWN)     ? 255 : 0;
+    hs->press_left     = (btns & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+    hs->press_right    = (btns & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+    hs->press_triangle = (btns & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+    hs->press_circle   = (btns & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+    hs->press_cross    = (btns & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+    hs->press_square   = (btns & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+    hs->press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
+    hs->press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
+
+    { static int said = 0;
+      if (!said && btns) { said = 1;
+          printf("[cellPad] keyboard active on port 0 (no controller there)\n");
+          fflush(stdout); } }
+}
+#endif

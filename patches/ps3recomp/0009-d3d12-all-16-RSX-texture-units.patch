+/* Which texture units a draw's fragment program samples, as a 16-bit mask
+ * (0 without a program, or when its ucode does not resolve). */
+static u32 dr_fp_units(const D3D12DrawRecord* dr)
+{
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!dr->fp_addr || !vm_base) return 0;
+    const u32 off = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
+    if (off == 0xFFFFFFFFu) return 0;
+    return rsx_fp_texture_units(vm_base + off, 4096);
+}

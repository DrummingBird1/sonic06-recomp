From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 21:20:09 +0200
Subject: [PATCH] D3D12 backend: decompile with the cube mask

A unit bound as a cube got a cube SRV, but the program was decompiled with a
mask of 0, as a 2D texture sampled with .xy. The rewrite that was meant to fix
this looked for a form the decompiler no longer emits. The decompiler takes
the mask itself: pass it, and drop the rewrite.
---
 libs/video/rsx_d3d12_backend.c | 25 ++++---------------------
 1 file changed, 4 insertions(+), 21 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 0414a637..b2e32f95 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -2540,9 +2540,9 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
     int n = -1, alpha_done = 0;
     if (!fp_consts_inline()) {
         n = shadow_key
-            ? rsx_fp_decompile_buffered_shadow_ex(vm_base + off, 4096, fp_ctrl, 0, shadow,
+            ? rsx_fp_decompile_buffered_shadow_ex(vm_base + off, 4096, fp_ctrl, cube_mask, shadow,
                                                   hlsl, sizeof(hlsl), &fp_nk)
-            : rsx_fp_decompile_buffered_ex(vm_base + off, 4096, fp_ctrl, 0,
+            : rsx_fp_decompile_buffered_ex(vm_base + off, 4096, fp_ctrl, cube_mask,
                                            hlsl, sizeof(hlsl), &fp_nk);
         if (n > 0 && fp_nk > VP_FPK_SLOTS) {
             static int _w = 0;
@@ -2564,9 +2564,9 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
         }
     }
     if (n <= 0)
-        n = shadow_key ? rsx_fp_decompile_shadow_ex(vm_base + off, 4096, fp_ctrl, 0, shadow,
+        n = shadow_key ? rsx_fp_decompile_shadow_ex(vm_base + off, 4096, fp_ctrl, cube_mask, shadow,
                                                     hlsl, sizeof(hlsl))
-                       : rsx_fp_decompile(vm_base + off, 4096, fp_ctrl, hlsl, sizeof(hlsl));
+                       : rsx_fp_decompile_ex(vm_base + off, 4096, fp_ctrl, cube_mask, hlsl, sizeof(hlsl));
     if (n > 0 && alpha_key && !alpha_done)
         rsx_fp_apply_alpha_test(hlsl, sizeof hlsl, alpha_key & 0xFFFFu, (float)(alpha_key >> 16) / 255.0f);
     if (n <= 0) { static int _e=0; if(PS3_LOG_FIRST(_e, 16)) printf("[FP] decompile fail (fp=0x%08X)\n", fp_addr); return NULL; }
@@ -2668,24 +2668,7 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
               }
           }
       } }
-    /* Retarget the samplers the guest bound as CUBE textures. The decompiler
-     * always emits 2D samplers; a cube is sampled with a 3-component direction
-     * and no texel-scale, and the emitted coordinate always ends in the fixed
-     * tail ".xy * rsx_texscale[N].xy", so both edits are exact replacements. */
     if (cube_mask) {
-        for (int _u = 0; _u < RSX_MAX_TEXTURES; _u++) {
-            if (!(cube_mask & (1u << _u))) continue;
-            char f1[64], r1[64], f2[64], r2[64];
-            snprintf(f1, sizeof f1, "Texture2D    rsx_tex%d", _u);
-            snprintf(r1, sizeof r1, "TextureCube  rsx_tex%d", _u);
-            hlsl_replace_all(hlsl, sizeof hlsl, f1, r1);
-            snprintf(f1, sizeof f1, "Texture2D rsx_tex%d", _u);
-            snprintf(r1, sizeof r1, "TextureCube rsx_tex%d", _u);
-            hlsl_replace_all(hlsl, sizeof hlsl, f1, r1);
-            snprintf(f2, sizeof f2, ".xy * rsx_texscale[%d].xy", _u);
-            snprintf(r2, sizeof r2, ".xyz");
-            hlsl_replace_all(hlsl, sizeof hlsl, f2, r2);
-        }
         { static int _n = 0; if (PS3_LOG_FIRST(_n, 4))
             fprintf(stderr, "[CUBE] fp=0x%X compiled with cube units mask 0x%X%c",
                     fp_addr, cube_mask, 10); }

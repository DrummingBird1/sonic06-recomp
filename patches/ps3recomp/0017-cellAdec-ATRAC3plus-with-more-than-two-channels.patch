From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 09:23:44 +0200
Subject: [PATCH] cellAdec: ATRAC3plus with more than two channels

e0000 in Sonic the Hedgehog is 5.1, and anything past stereo was silence. The
AU header counts 1, 2, 3, 4, 6, 7, 8 channels. Output is interleaved L R C LFE
and the surrounds; the decoder delivers LFE last from six channels up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/codec/cellAdec.c                     | 41 ++++++++++++++---------
 third_party/at3_standalone/at3_bridge.cpp |  5 +++
 third_party/at3_standalone/at3_bridge.h   |  4 +++
 3 files changed, 34 insertions(+), 16 deletions(-)

diff --git a/libs/codec/cellAdec.c b/libs/codec/cellAdec.c
index 1ac1ae9d..57348fff 100644
--- a/libs/codec/cellAdec.c
+++ b/libs/codec/cellAdec.c
@@ -111,16 +111,22 @@ static void adec_drop_all(AdecSlot* a)
 }
 
 /* One ATRAC3plus AU: an 8-byte 0x0FD0 header, then the frame. Header bytes 2-3
- * are rate:3 channels:3 size:10. Returns the PCM, or NULL to send silence. */
+ * are rate:3 channels:3 size:10, the channel field counting 1, 2, 3, 4, 6, 7, 8.
+ * Mono goes out as stereo, anything else interleaved as L R C LFE and the
+ * surrounds (e0000 in Sonic the Hedgehog is 5.1). Returns the PCM, or NULL to
+ * send silence. */
 static u8* adec_decode_atrac3plus(AdecSlot* a, u32 ea, u32 size, u32* bytes)
 {
     enum { SAMPLES = 2048 };
+    static const u8 k_channels[8] = { 0, 1, 2, 3, 4, 6, 7, 8 };
     u8 au[4096];
     if (size <= 8 || size > sizeof au) return NULL;
     for (u32 i = 0; i < size; i++) au[i] = vm_read8(ea + i);
     if (au[0] != 0x0F || au[1] != 0xD0) return NULL;
-    const int channels = (((u32)au[2] << 8 | au[3]) >> 10) & 7;
-    if (channels < 1 || channels > 2) return NULL;
+    const int channels = k_channels[(((u32)au[2] << 8 | au[3]) >> 10) & 7];
+    if (!channels) return NULL;
+    const int out_ch = channels == 1 ? 2 : channels;
+    *bytes = SAMPLES * 4u * (u32)out_ch;
     if (a->dec && a->dec_channels != channels) { at3p_close(a->dec); a->dec = NULL; }
     if (!a->dec) {
         int block = (int)size - 8;
@@ -128,26 +134,29 @@ static u8* adec_decode_atrac3plus(AdecSlot* a, u32 ea, u32 size, u32* bytes)
         a->dec_channels = channels;
         if (!a->dec) return NULL;
     }
-    float* l = (float*)malloc(SAMPLES * 2u * sizeof(float));
-    if (!l) return NULL;
-    float* r = l + SAMPLES;
+    float* planes = (float*)malloc(SAMPLES * 8u * sizeof(float));
+    if (!planes) return NULL;
+    /* From six channels up the decoder delivers LFE last. */
+    float* to[8];
+    for (int c = 0; c < channels; c++) {
+        const int plane = channels < 6 || c < 3 ? c : c == channels - 1 ? 3 : c + 1;
+        to[c] = planes + SAMPLES * plane;
+    }
     int n = 0;
     u8* out = NULL;
-    if (at3p_decode(a->dec, l, r, &n, au + 8, (int)size - 8) >= 0 && n == SAMPLES)
-        out = (u8*)malloc(SAMPLES * 8u);
+    if (at3p_decode_planes(a->dec, to, &n, au + 8, (int)size - 8) >= 0 && n == SAMPLES)
+        out = (u8*)malloc(*bytes);
     if (out) {
-        for (int i = 0; i < SAMPLES; i++) {
-            const float f[2] = { l[i], channels == 2 ? r[i] : l[i] };
-            for (int c = 0; c < 2; c++) {
+        if (channels == 1) memcpy(planes + SAMPLES, planes, SAMPLES * sizeof(float));
+        u8* d = out;
+        for (int i = 0; i < SAMPLES; i++)
+            for (int c = 0; c < out_ch; c++, d += 4) {
                 u32 w;
-                memcpy(&w, &f[c], 4);
-                u8* d = out + (u32)i * 8u + (u32)c * 4u;
+                memcpy(&w, &planes[SAMPLES * c + i], 4);
                 d[0] = (u8)(w >> 24); d[1] = (u8)(w >> 16); d[2] = (u8)(w >> 8); d[3] = (u8)w;
             }
-        }
-        *bytes = SAMPLES * 8u;
     }
-    free(l);
+    free(planes);
     return out;
 }
 
diff --git a/third_party/at3_standalone/at3_bridge.cpp b/third_party/at3_standalone/at3_bridge.cpp
index 519a0dda..d2aafbb8 100644
--- a/third_party/at3_standalone/at3_bridge.cpp
+++ b/third_party/at3_standalone/at3_bridge.cpp
@@ -11,3 +11,8 @@ extern "C" int   at3p_decode(void* dec, float* left, float* right, int* samples,
     float* out[2] = { left, right };
     return atrac3p_decode_frame((ATRAC3PContext*)dec, out, samples, frame, frame_bytes);
 }
+extern "C" int   at3p_decode_planes(void* dec, float** planes, int* samples,
+                                    const uint8_t* frame, int frame_bytes)
+{
+    return atrac3p_decode_frame((ATRAC3PContext*)dec, planes, samples, frame, frame_bytes);
+}
diff --git a/third_party/at3_standalone/at3_bridge.h b/third_party/at3_standalone/at3_bridge.h
index fa1d8e3a..29f06392 100644
--- a/third_party/at3_standalone/at3_bridge.h
+++ b/third_party/at3_standalone/at3_bridge.h
@@ -12,6 +12,10 @@ void  at3p_flush(void* dec);
  * consumed or < 0 on error; *samples gets the per-channel count. */
 int   at3p_decode(void* dec, float* left, float* right, int* samples,
                   const uint8_t* frame, int frame_bytes);
+/* The same for any channel count: planes holds one buffer per channel, in the
+ * order of the channel units in the frame. */
+int   at3p_decode_planes(void* dec, float** planes, int* samples,
+                         const uint8_t* frame, int frame_bytes);
 #ifdef __cplusplus
 }
 #endif

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Wed, 4 Nov 2026 05:30:08 +0200
Subject: [PATCH] Closing the game window ends the game; Alt alone no longer
 freezes it; PAD_MOUSE_FLIP

- boot_main: when the window is closed (X, Alt+F4, Esc), the process ends.
  It used to go on without a window, the guest and its sound running, and a
  launcher waiting on it never saw it exit. RSX_KEEP_RUNNING=1 keeps that.
- D3D12 window: WM_SYSCOMMAND SC_KEYMENU is swallowed. Alt (or F10) on its
  own entered the window menu's modal loop on the thread that presents, and
  the game stood still until the next key: 10 s between two taps of Alt.
- cellPad: PAD_MOUSE_FLIP=x|y|xy turns a mouse axis around. Sonic '06 orbits
  its camera with the right stick, so a mouse that looks where it goes needs
  x flipped (measured in Wave Ocean). PAD_MOUSE_DEBUG also logs each 64th
  poll and every recentre.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 libs/input/cellPad.c            |  35 +++++++--
 libs/video/rsx_d3d12_backend.c  |   8 +++
 runtime/ppu/tests/boot_main.cpp | 122 ++++++++++++++++++--------------
 3 files changed, 105 insertions(+), 60 deletions(-)

diff --git a/libs/input/cellPad.c b/libs/input/cellPad.c
index e70132fa..838989a0 100644
--- a/libs/input/cellPad.c
+++ b/libs/input/cellPad.c
@@ -735,9 +735,10 @@ static void pad_shutdown_backend(void)
  * Enter = START, Tab = SELECT.
  *
  * PAD_MOUSE=<1..100> makes the mouse the right stick, with that sensitivity:
- * while the game window has the focus the cursor is hidden and held at the
- * centre of the window, and how fast it moves away from there is how far the
- * stick is pushed. A camera key that is held wins over the mouse.
+ * while the game window has the focus the cursor is hidden and kept inside
+ * the window, and how fast it moves is how far the stick is pushed.
+ * PAD_MOUSE_FLIP=x|y|xy turns an axis around. A camera key that is held wins
+ * over the mouse.
  * -----------------------------------------------------------------------*/
 
 #ifdef _WIN32
@@ -814,6 +815,12 @@ static float   s_mouse_x, s_mouse_y;   /* smoothed stick, -1..1 */
 static unsigned long long s_mouse_moved_ms;   /* the last poll that saw a motion */
 #define PAD_MOUSE_HOLD_MS 50
 static int     s_mouse_dbg;         /* PAD_MOUSE_DEBUG */
+/* PAD_MOUSE_FLIP=x, y or xy: that axis of the mouse pushes the stick the other
+ * way. Sonic '06 orbits its camera with the right stick, so stick-left moves
+ * the camera left around the character and the view turns right: a mouse that
+ * looks where it goes needs x flipped there (measured in Wave Ocean). Stick-up
+ * lowers the camera and the view tilts up, which is already how a mouse looks. */
+static float   s_mouse_flip_x = 1, s_mouse_flip_y = 1;
 
 /* The window class's cursor is what DefWindowProc shows on WM_SETCURSOR, so a
  * blank one there hides the cursor over the game from this (non-window)
@@ -857,17 +864,22 @@ static void pad_mouse_poll(HWND fg, PadHostState* hs)
     ClientToScreen(fg, &c);
     RECT sr = rc;
     MapWindowPoints(fg, NULL, (POINT*)&sr, 2);
-    ClipCursor(&sr);
-    GetCursorPos(&p);
+    const BOOL clipped = ClipCursor(&sr);
+    const BOOL got = GetCursorPos(&p);
     const unsigned long long now = pad_now_ms();
+    { static unsigned polls = 0;
+      if (s_mouse_dbg && (polls++ % 64) == 0)
+          printf("[cellPad] mouse look: poll %u, cursor %ld,%ld (read %d, clip %d, err %lu, tick %llu)\n",
+                 polls, (long)p.x, (long)p.y, got, clipped, got && clipped ? 0ul : GetLastError(), now); }
+    if (!got) return;
     const unsigned long long dt = s_mouse_ms ? now - s_mouse_ms : 0;
     float fx = 0, fy = 0;
     if (dt > 0 && dt < 200) {
         /* Pixels a millisecond, times the sensitivity: at 50, 1 px/ms (a
          * brisk flick) is the stick pushed all the way. */
         const float k = (float)s_mouse_sens * 0.02f / (float)dt;
-        fx = (float)(p.x - s_mouse_ref.x) * k;
-        fy = (float)(p.y - s_mouse_ref.y) * k;
+        fx = (float)(p.x - s_mouse_ref.x) * k * s_mouse_flip_x;
+        fy = (float)(p.y - s_mouse_ref.y) * k * s_mouse_flip_y;
         /* PAD_MOUSE_DEBUG=1: every motion and every stick value, with GetTickCount64. */
         { static int n = 0;
           if ((p.x != s_mouse_ref.x || p.y != s_mouse_ref.y) && (s_mouse_dbg || PS3_LOG_FIRST(n, 3)))
@@ -880,6 +892,12 @@ static void pad_mouse_poll(HWND fg, PadHostState* hs)
     if (p.x < sr.left + qx || p.x > sr.right - qx || p.y < sr.top + qy || p.y > sr.bottom - qy) {
         SetCursorPos(c.x, c.y);
         s_mouse_ms = 0;
+        { static int n = 0;
+          if (s_mouse_dbg && PS3_LOG_FIRST(n, 40)) {
+              POINT q; GetCursorPos(&q);
+              printf("[cellPad] mouse look: recentre from %ld,%ld to %ld,%ld (reads %ld,%ld), window %ld,%ld..%ld,%ld (tick %llu)\n",
+                     (long)p.x, (long)p.y, (long)c.x, (long)c.y, (long)q.x, (long)q.y,
+                     (long)sr.left, (long)sr.top, (long)sr.right, (long)sr.bottom, now); } }
     }
     /* The mouse reports about every 16 ms, and the pad is polled more often
      * than that, so most polls in the middle of a motion see none: the stick
@@ -914,6 +932,9 @@ static void pad_poll_keyboard(void)
         pad_keys_load();
         const char* m = getenv("PAD_MOUSE");
         s_mouse_sens = m ? atoi(m) : 0;
+        const char* fl = getenv("PAD_MOUSE_FLIP");
+        if (fl && strchr(fl, 'x')) s_mouse_flip_x = -1;
+        if (fl && strchr(fl, 'y')) s_mouse_flip_y = -1;
         s_mouse_dbg = getenv("PAD_MOUSE_DEBUG") ? 1 : 0;
         if (s_mouse_sens < 0) s_mouse_sens = 0;
         if (s_mouse_sens > 100) s_mouse_sens = 100;
diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 270824c0..db1b97b7 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -778,6 +778,14 @@ static LRESULT CALLBACK d3d12_wndproc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
             DestroyWindow(hwnd);
         }
         return 0;
+    case WM_SYSCOMMAND:
+        /* Alt (or F10) on its own: DefWindowProc enters the window menu's
+         * modal loop, and this thread, which also presents the frames, stays
+         * in it until the next key or click. The game stood still for 10 s
+         * between two taps of Alt. There is no menu to open, so the keyboard
+         * never enters it; Alt+F4 is SC_CLOSE and still closes the window. */
+        if ((wp & 0xFFF0) == SC_KEYMENU) return 0;
+        break;
     }
     return DefWindowProcA(hwnd, msg, wp, lp);
 }

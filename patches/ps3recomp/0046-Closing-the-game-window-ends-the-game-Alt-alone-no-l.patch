     }
     AcquireSRWLockExclusive(&s_env_lock);
     const char* val = NULL; int found = 0;
@@ -617,7 +617,23 @@ static DWORD WINAPI vblank_ticker(LPVOID)
             if(++s_q3 % 8 == 0){ int r=sys_event_queue_inject(qid, 0x1234, 0, 0, 0);
               static int _n=0; if(_n++<12) fprintf(stderr,"[INJQ3] injected q%u event rc=%d\n",qid,r); } }
         if (rsx_ok) {
-            if (rsx_pump_messages() != 0) { rsx_ok = 0; }
+            if (rsx_pump_messages() != 0) {
+                rsx_ok = 0;
+#ifdef _WIN32
+                /* The player closed the window (its X, Alt+F4, or Esc when
+                 * D3D12_ESC allows it). Going on without it left the guest
+                 * running with no window and its sound still playing, and the
+                 * launcher kept saying the game runs. There is no guest-side
+                 * shutdown to wait for, and an orderly exit would run DLL
+                 * teardown under threads still in guest code, so the process
+                 * ends here. RSX_KEEP_RUNNING=1 keeps the old behaviour. */
+                if (!getenv("RSX_KEEP_RUNNING")) {
+                    fprintf(stderr, "[boot] the window was closed: exiting\n");
+                    fflush(stdout); fflush(stderr);
+                    TerminateProcess(GetCurrentProcess(), 0);
+                }
+#endif
+            }
             if (getenv("YDKJ_PACETRACE")) {
                 static ULONGLONG s_win=0; static int s_pf=0, s_pres=0; static ULONGLONG s_presms=0;
                 s_pf += fired; s_pres++;
@@ -1018,45 +1034,45 @@ static DWORD WINAPI debug_console(LPVOID param)
             dump_threads("console", self);
         } else if (!strcmp(verb, "find32") && sscanf(cmd, "%*s %x", &a) == 1) {
             /* find32 <hex>: every aligned big-endian u32 equal to <hex> in committed
-             * guest memory below 0xC0000000 (first 4096 hits). */

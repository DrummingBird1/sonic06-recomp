From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DrummingBird1 <1979036+DrummingBird1@users.noreply.github.com>
Date: Sun, 1 Nov 2026 02:22:50 +0200
Subject: [PATCH] d3d12: shadow maps, and a draw trace

bind_texture dropped depth formats, so a shadow map never reached its unit and
the program's lighting term read 0. Bind the depth surface and compare in the
program, as the RSX does. DRAW_TRACE lists every op of chosen batches.
---
 libs/video/rsx_d3d12_backend.c | 90 +++++++++++++++++++++++++++++++---
 libs/video/rsx_fp_decompiler.c |  8 +++
 libs/video/rsx_fp_decompiler.h |  3 ++
 3 files changed, 95 insertions(+), 6 deletions(-)

diff --git a/libs/video/rsx_d3d12_backend.c b/libs/video/rsx_d3d12_backend.c
index 3fe2920a..81a0eaf7 100644
--- a/libs/video/rsx_d3d12_backend.c
+++ b/libs/video/rsx_d3d12_backend.c
@@ -137,6 +137,7 @@ typedef struct {
     u32 zeta_off;       /* depth surface (SET_SURFACE_ZETA_OFFSET) when the surface has one */
     int no_color;       /* colour target NONE with a depth surface: a depth-only pass */
     int tex_ds[RSX_MAX_TEXTURES];   /* pre-pass: OffDS read through unit u (its colour copy is tex_rt), -1 = none */
+    int tex_zs[RSX_MAX_TEXTURES];   /* pre-pass: OffDS a shadow-compare unit reads directly, -1 = none */
     /* Guest viewport rect at draw time (target pixels). Sub-viewport layouts
      * (wave's debug tiles) position quads with this, not with constants --
      * forcing full-target viewports drew every tile window-sized. */
@@ -257,6 +258,8 @@ typedef struct {
                              * stale compile forever. */
     u32 cmask;              /* colour write mask (PSO key) */
     u32 cull;               /* packed face culling (PSO key) */
+    u32 shadow_key;         /* depth-compare setup of the units (PSO key): the HLSL
+                             * compares inside the program */
     u32 cube_mask;          /* which units are cube textures (PSO key): the HLSL
                              * declares those samplers as TextureCube, so a cube
                              * and a 2D variant of the same program are different
@@ -2326,6 +2329,27 @@ static u32 dr_cube_mask(const D3D12DrawRecord* dr)
     return m;
 }
 
+/* Depth-compare setup of a draw's texture units. A D24/D16 texture whose
+ * ADDRESS register names a compare function is a shadow map: the RSX answers a
+ * TEX with the compare result, not the depth. Returns a key for the pipeline
+ * cache, 0 when no unit compares. */
+static u32 dr_shadow_descs(const D3D12DrawRecord* dr, rsx_fp_shadow_desc out[RSX_MAX_TEXTURES])
+{
+    u32 key = 0;
+    for (int u = 0; u < RSX_MAX_TEXTURES; u++) {
+        memset(&out[u], 0, sizeof out[u]);
+        const u32 base = dr->tex[u].fmt & 0x9Fu;
+        if (!dr->tex[u].set || (base != 0x90 && base != 0x92)) continue;
+        rsx_fp_shadow_desc_from_texture(&out[u], dr->tex[u].fmt, dr->tex[u].cube ? 3 : 2,
+                                        (u32)dr->tex[u].cube, dr->tex[u].mips, dr->tex[u].filter,
+                                        dr->tex[u].addr, dr->tex[u].ctrl0);
+        if (out[u].enabled != 1) { memset(&out[u], 0, sizeof out[u]); continue; }
+        key = key * 31u + (((u32)u << 8) | ((u32)out[u].func << 4) |
+                           ((u32)out[u].unnormalized << 2) | ((u32)out[u].linear << 1) | 1u);
+    }
+    return key;
+}
+
 /* Which texture units a draw's fragment program samples, as a 16-bit mask
  * (0 without a program, or when its ucode does not resolve). */
 static u32 dr_fp_units(const D3D12DrawRecord* dr)
@@ -2340,7 +2364,8 @@ static u32 dr_fp_units(const D3D12DrawRecord* dr)
 

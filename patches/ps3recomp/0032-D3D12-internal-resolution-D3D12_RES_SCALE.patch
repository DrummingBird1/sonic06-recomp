 static ID3D12Resource* s_screen_copy = NULL;
+/* D3D12_RES_SCALE=1..4: the internal resolution, as a multiple of the guest's.
+ * Every surface keeps its guest size in its w/h and every draw record stays in
+ * guest pixels; only the D3D12 resources, and the pixel rectangles handed to
+ * the rasterizer and to copies, are multiplied. Needs the present pass, which
+ * draws the larger frame into the window (pp_read_env sets it). */
+static float s_rs = 1.0f;
+
+static u32 rs_px(u32 v) { return s_rs == 1.0f ? v : (u32)((float)v * s_rs + 0.5f); }
+
+/* A rectangle in guest pixels as the viewport and scissor of a scaled surface.
+ * Both edges are scaled, so neighbouring rectangles still meet. */
+static void rs_set_rect(ID3D12GraphicsCommandList* cl, u32 x, u32 y, u32 w, u32 h)
+{
+    const u32 x0 = rs_px(x), y0 = rs_px(y), x1 = rs_px(x + w), y1 = rs_px(y + h);
+    D3D12_VIEWPORT vp = {(float)x0, (float)y0, (float)(x1 - x0), (float)(y1 - y0), 0.0f, 1.0f};
+    D3D12_RECT sc = {(LONG)x0, (LONG)y0, (LONG)x1, (LONG)y1};
+    cl->lpVtbl->RSSetViewports(cl, 1, &vp);
+    cl->lpVtbl->RSSetScissorRects(cl, 1, &sc);
+}

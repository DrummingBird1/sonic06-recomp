+/* WPOS under D3D12_RES_SCALE. The program runs on the scaled surface, so
+ * SV_POSITION counts scaled pixels, and a program that addresses a screen-sized
+ * texture by WPOS, or compares it with a guest rectangle, wants guest pixels.
+ * Divided, not floored: the fraction keeps the extra detail. */
+static void fp_wpos_rescale(char* hlsl, size_t cap)
+{
+    char to[96];
+    snprintf(to, sizeof to, "_rsx_wpos(float4(input.position.xy * %.9g, input.position.zw))",
+             1.0 / (double)s_rs);
+    hlsl_replace_all(hlsl, cap, "_rsx_wpos(input.position)", to);
+}

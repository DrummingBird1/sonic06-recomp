     /* FP_LIST=1: every program the title actually compiles, with its size. A
      * fragment program that hangs the GPU shows up here as an implausible
      * instruction count long before it shows up as a TDR. */
@@ -3522,6 +3537,39 @@ static ID3D12PipelineState* vp_get_fp_pso(int vs_idx, u32 fp_addr, u32 blend, in
     return pso;
 }
 
+/* A recorded draw's fragment program, handed to a worker (shader_prefetch) the
+ * first time its HLSL could differ from everything seen so far. render_frame
+ * builds the pipelines only after the walk, so a compile started here runs
+ * while the walker records the rest of the frame, and vp_get_fp_pso then waits
+ * for it, or reads it from the cache. A draw costs a lookup by address and the
+ * HLSL inputs, without hashing the program: a program that changes in place
+ * behind the same address only misses this head start. */
+static void fp_prefetch(const D3D12DrawRecord* dr)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("D3D12_SHADER_PREFETCH");
+                  on = !(e && e[0] == '0') && !getenv("FP_OFF") && !getenv("FP_FORCE") &&
+                       !getenv("FP_ONE") && !getenv("FP_KILL") && !getenv("FP_SHOW") &&
+                       !getenv("FP_IDCOLOR") && !getenv("FP_TEX"); }
+    if (!on || !dr->fp_addr) return;
+    extern uint8_t* vm_base;
+    extern u32 cellGcmResolveLocated(int local, u32 offset);
+    if (!vm_base) return;
+    rsx_fp_shadow_desc shadow[RSX_MAX_TEXTURES];
+    const u32 shadow_key = dr_shadow_descs(dr, shadow), cube = dr_cube_mask(dr), alpha = dr_alpha_key(dr);
+    u32 k = 2166136261u;
+    const u32 parts[5] = { dr->fp_addr, dr->fp_ctrl, cube, shadow_key, alpha };
+    for (int i = 0; i < 5; i++) { k ^= parts[i]; k *= 16777619u; }
+    static u32 seen[1024];
+    if (seen[k & 1023] == (k | 1u)) return;
+    seen[k & 1023] = k | 1u;
+    const u32 off = cellGcmResolveLocated((dr->fp_addr & 0x3u) == 1, dr->fp_addr & ~0x3u);
+    if (off == 0xFFFFFFFFu) return;
+    static char hlsl[RSX_FP_HLSL_BUFFER_SIZE];
+    if (fp_build_hlsl(off, dr->fp_addr, dr->fp_ctrl, cube, shadow, shadow_key, alpha, hlsl, sizeof hlsl) <= 0) return;
+    shader_prefetch(hlsl, strlen(hlsl), "ps_5_0");
+}
+
 /* Upload the guest texture for a VP draw into a per-frame texture slot
  * (re-uploaded every frame: gcm/cube's plasma animates in guest memory).
  * Returns the slot index or -1. Must run while the command list is open,
@@ -8120,6 +8168,7 @@ static void d3d12_draw_arrays(void* ud, u32 primitive, u32 first, u32 count)
                 } else { dr->vp_x = dr->vp_y = dr->vp_w = dr->vp_h = 0; }
                 dr->cb_slot = s_d3d.draw_count;
                 vp_record_cb(s_d3d.draw_count, dr->vs_idx, dr);
+                fp_prefetch(dr);
                 s_d3d.draw_count++;
             }
             return;
@@ -8235,6 +8284,7 @@ static void d3d12_draw_arrays(void* ud, u32 primitive, u32 first, u32 count)
             } else { dr->vp_x = dr->vp_y = dr->vp_w = dr->vp_h = 0; }
             dr->cb_slot = s_d3d.draw_count;
                 vp_record_cb(s_d3d.draw_count, dr->vs_idx, dr);
+                fp_prefetch(dr);
             s_d3d.draw_count++;
             /* Anchor for merging the next DRAW_ARRAYS batch of this stream. */
             s_d3d.merge_prev_draw  = (primitive == RSX_PRIMITIVE_TRIANGLES);
@@ -8402,6 +8452,7 @@ static void d3d12_draw_indexed(void* ud, u32 primitive, u32 first, u32 count)
         } else { dr->vp_x = dr->vp_y = dr->vp_w = dr->vp_h = 0; }
         dr->cb_slot = s_d3d.draw_count;
                 vp_record_cb(s_d3d.draw_count, dr->vs_idx, dr);
+                fp_prefetch(dr);
         s_d3d.draw_count++;
         /* Anchor for merging the next batch of this indexed stream. */
         s_d3d.merge_prev_draw = (primitive == RSX_PRIMITIVE_TRIANGLES);

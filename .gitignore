# Temporary trace hooks (tools/re/hook.py): never commit.
src/zz_*

# launcher settings of this machine
launcher.local.json
# this machine's paths for agents (AGENTS.md is the shared part)
AGENTS.local.md

# The launcher's build output, and the tools it downloads (FFmpeg, ps3recomp).
launcher/bin/
launcher/obj/
deps/
# What package_release.ps1 puts inside the release exe
launcher/payload/

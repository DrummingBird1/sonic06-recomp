<Window x:Class="Sonic06Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Sonic06Launcher"
        Title="sonic06-recomp" Width="1120" Height="760" MinWidth="960" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        FlowDirection="{Binding Flow, Source={x:Static l:Loc.I}}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
        <!-- One setting: label and description at the start, the control at the end. -->
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,10"/>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Background="{StaticResource Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,28">
                        <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xE7FC;" Style="{StaticResource Icon}" FontSize="20" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="sonic06-recomp" FontSize="15" FontWeight="SemiBold" FlowDirection="LeftToRight"/>
                            <TextBlock Text="PC port · BLES00028" Style="{StaticResource Sub}" FontSize="11" FlowDirection="LeftToRight"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavPlay" GroupName="nav" Style="{StaticResource NavButton}" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{l:T nav_play}" Margin="14,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSetup" GroupName="nav" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE90F;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{l:T nav_setup}" Margin="14,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Warn}" Margin="10,0,0,0" VerticalAlignment="Center"
                                         Visibility="{Binding SetupNeeded, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavGraphics" GroupName="nav" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{l:T nav_graphics}" Margin="14,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" GroupName="nav" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{l:T nav_settings}" Margin="14,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSupport" GroupName="nav" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE897;" Style="{StaticResource Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="{l:T nav_support}" Margin="14,0,0,0" FontSize="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource Sub}" FontSize="11"
                               Margin="22,0,16,18" VerticalAlignment="Bottom"/>
                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True"
                            FlowDirection="LeftToRight">
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE921;" Click="OnMinimize"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE922;" Click="OnMaximize"/>
                    <Button Style="{StaticResource ChromeButton}" Content="&#xE8BB;" Click="OnClose"/>
                </StackPanel>

                <!-- Play -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,24"
                              Visibility="{Binding IsChecked, ElementName=NavPlay, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="900">
                        <Border x:Name="Hero" CornerRadius="18" Background="{StaticResource HeroGradient}" Padding="36,34" Margin="0,0,0,16"
                                SizeChanged="OnHeroSize">
                            <Grid>
                                <Ellipse Width="320" Height="320" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-110,0"
                                         Fill="#22FFFFFF"/>
                                <Ellipse Width="180" Height="180" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,80,-120"
                                         Fill="#14FFFFFF"/>
                                <StackPanel>
                                    <TextBlock Text="sonic06-recomp" FontSize="34" FontWeight="Bold" FlowDirection="LeftToRight"
                                               HorizontalAlignment="Left"/>
                                    <TextBlock Text="{l:T app_subtitle}" FontSize="14" Foreground="#D6E4FF" Margin="0,6,0,26"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{Binding StateBrush}">
                                            <TextBlock Text="{Binding StateGlyph}" Style="{StaticResource Icon}" FontSize="13" HorizontalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding StateDetail}" Foreground="#C8D6EE" FontSize="12.5"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource PrimaryButton}" Padding="44,14" FontSize="16" Click="OnPlay"
                                                IsEnabled="{Binding CanPlay}"
                                                Visibility="{Binding ReadyToPlay, Converter={StaticResource BoolVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding PlayLabel}" FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource PrimaryButton}" Padding="30,14" FontSize="15" Click="OnGoSetup"
                                                Visibility="{Binding SetupNeeded, Converter={StaticResource BoolVis}}">
                                            <TextBlock Text="{l:T play_go_setup}" FontSize="15" FontWeight="SemiBold"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T play_quick}" Style="{StaticResource H2}"/>
                                <WrapPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="{l:T gfx_mode}" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding ModeOptions}" SelectedValuePath="Value"
                                                  SelectedValue="{Binding Settings.Fullscreen}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8">
                                        <TextBlock Text="{l:T gfx_size}" Style="{StaticResource Sub}" Margin="0,0,0,6"/>
                                        <ComboBox ItemsSource="{Binding SizeOptions}" SelectedValuePath="Value" MinWidth="180"
                                                  SelectedValue="{Binding Settings.WindowSize}" IsEnabled="{Binding WindowSizeEnabled}"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,24,8" VerticalAlignment="Bottom">
                                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.VSync}" Margin="0,0,0,6">
                                            <TextBlock Text="{l:T gfx_vsync}"/>
                                        </CheckBox>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{l:T play_disclaimer}" Style="{StaticResource Sub}" Margin="4,4,4,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Setup -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,24"
                              Visibility="{Binding IsChecked, ElementName=NavSetup, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="{l:T setup_title}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{l:T setup_subtitle}" Style="{StaticResource Sub}" Margin="0,6,0,18"/>
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Padding="26,12" Click="OnSetUpEverything"
                                        IsEnabled="{Binding NotBusy}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE896;" Style="{StaticResource Icon}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{l:T setup_all}" FontWeight="SemiBold" FontSize="14"/>
                                    </StackPanel>
                                </Button>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                    <TextBlock Text="{Binding StateTitle}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding StateDetail}" Style="{StaticResource Sub}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="8,8">
                            <ItemsControl ItemsSource="{Binding Status}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="12,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#3B2A12"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                <Setter Property="Background" Value="#123222"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                                            <Setter Property="Text" Value="&#xE7BA;"/>
                                                            <Setter Property="Foreground" Value="{StaticResource Warn}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Ok}" Value="True">
                                                                    <Setter Property="Text" Value="&#xE73E;"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource Good}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T setup_actions}" Style="{StaticResource H2}"/>
                                <WrapPanel>
                                    <Button Content="{l:T setup_tools}" Click="OnInstallTools" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_iso}" Click="OnChooseIso" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_folder}" Click="OnChooseFolder" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_rpcs3}" Click="OnChooseRpcs3" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_decrypt}" Click="OnDecrypt" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_ffmpeg}" Click="OnDownloadFfmpeg" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_ffmpeg_folder}" Click="OnChooseFfmpeg" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                    <Button Content="{l:T setup_build}" Click="OnBuild" IsEnabled="{Binding NotBusy}" Margin="0,0,8,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T setup_activity}" Style="{StaticResource H2}"/>
                                <TextBox x:Name="LogBox" IsReadOnly="True" Height="190" TextWrapping="NoWrap" FlowDirection="LeftToRight"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         Background="#0F131A" Foreground="#C9D1DD" BorderBrush="{StaticResource Line}"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Padding="8"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Graphics -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,24"
                              Visibility="{Binding IsChecked, ElementName=NavGraphics, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="{l:T gfx_title}" Style="{StaticResource H1}"/>
                        <TextBlock Text="{l:T gfx_subtitle}" Style="{StaticResource Sub}" Margin="0,6,0,18"/>
                        <Border Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <TextBlock Text="{l:T gfx_presets}" Style="{StaticResource H2}" Margin="0,0,20,0" VerticalAlignment="Center"/>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="{l:T gfx_preset_performance}" Tag="performance" Click="OnPreset" Margin="0,0,8,0"/>
                                    <Button Content="{l:T gfx_preset_balanced}" Tag="balanced" Click="OnPreset" Margin="0,0,8,0"/>
                                    <Button Content="{l:T gfx_preset_quality}" Tag="quality" Click="OnPreset" Margin="0,0,8,0"/>
                                    <Button Content="{l:T gfx_reset}" Tag="reset" Click="OnPreset"/>
                                </WrapPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T gfx_display}" Style="{StaticResource H2}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T gfx_mode}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ModeOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.Fullscreen}"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T gfx_size}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SizeOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.WindowSize}" IsEnabled="{Binding WindowSizeEnabled}"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T gfx_aspect}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AspectOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.Aspect}"/>
                                </Grid>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.VSync}" Margin="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T gfx_vsync}"/>
                                        <TextBlock Text="{l:T gfx_vsync_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.ShaderAsync}" Margin="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T gfx_async}"/>
                                        <TextBlock Text="{l:T gfx_async_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T gfx_quality}" Style="{StaticResource H2}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T gfx_res}"/>
                                        <TextBlock Text="{l:T gfx_res_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ResOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.ResScale}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T gfx_scaler}"/>
                                        <TextBlock Text="{l:T gfx_scaler_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ScalerOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.Scaler}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T gfx_sharpen}"/>
                                        <TextBlock Text="{l:T gfx_sharpen_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.Sharpen}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Sharpen, StringFormat={}{0}%}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                                </Grid>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.Fxaa}" Margin="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T gfx_aa}"/>
                                        <TextBlock Text="{l:T gfx_aa_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </CheckBox>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T gfx_aniso}"/>
                                        <TextBlock Text="{l:T gfx_aniso_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AnisoOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.Aniso}" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="240"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T gfx_brightness}" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="50" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True"
                                            Value="{Binding Settings.Brightness}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Settings.Brightness, StringFormat={}{0}%}" VerticalAlignment="Center"
                                               HorizontalAlignment="Right" FlowDirection="LeftToRight"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,24"
                              Visibility="{Binding IsChecked, ElementName=NavSettings, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="{l:T settings_title}" Style="{StaticResource H1}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T settings_launcher}" Style="{StaticResource H2}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{l:T settings_ui_language}" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding UiLanguageOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding UiLanguage}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T settings_game}" Style="{StaticResource H2}"/>
                                <Grid Style="{StaticResource Row}">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T settings_game_language}"/>
                                        <TextBlock Text="{l:T settings_game_language_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GameLanguageOptions}" SelectedValuePath="Value"
                                              SelectedValue="{Binding Settings.Language}" VerticalAlignment="Center"/>
                                </Grid>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.Mute}" Margin="0,10">
                                    <TextBlock Text="{l:T settings_mute}"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T settings_controls}" Style="{StaticResource H2}"/>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.Keyboard}" Margin="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T settings_keyboard}"/>
                                        <TextBlock Text="{l:T settings_keyboard_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </CheckBox>
                                <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Settings.EscCloses}" Margin="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{l:T settings_esc}"/>
                                        <TextBlock Text="{l:T settings_esc_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Support -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="36,4,36,24"
                              Visibility="{Binding IsChecked, ElementName=NavSupport, Converter={StaticResource BoolVis}}">
                    <StackPanel MaxWidth="900">
                        <TextBlock Text="{l:T support_title}" Style="{StaticResource H1}" Margin="0,0,0,18"/>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <DockPanel Margin="0,4,0,14">
                                    <Button DockPanel.Dock="Right" Content="{l:T support_report}" Click="OnReport" MinWidth="200" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T support_report}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{l:T support_report_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource Line}"/>
                                <DockPanel Margin="0,14">
                                    <Button DockPanel.Dock="Right" Content="{l:T support_update}" Click="OnUpdate" IsEnabled="{Binding NotBusy}"
                                            MinWidth="200" VerticalAlignment="Center"/>
                                    <StackPanel Margin="0,0,20,0">
                                        <TextBlock Text="{l:T support_update}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{l:T support_update_desc}" Style="{StaticResource Sub}"/>
                                    </StackPanel>
                                </DockPanel>
                                <Border Height="1" Background="{StaticResource Line}"/>
                                <DockPanel Margin="0,14,0,4">
                                    <Button DockPanel.Dock="Right" Content="{l:T support_logs}" Click="OnLogs" MinWidth="200" VerticalAlignment="Center"/>
                                    <Grid/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="{l:T support_about}" Style="{StaticResource H2}"/>
                                <TextBlock Text="{l:T support_about_text}" Style="{StaticResource Sub}" FontSize="13"/>
                                <TextBlock Text="{Binding VersionText}" Style="{StaticResource Sub}" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Progress of a long step -->
                <Border Grid.Row="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Padding="36,12" Visibility="{Binding Busy, Converter={StaticResource BoolVis}}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}" Style="{StaticResource Sub}" Margin="16,0,0,0"
                                   FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BusyText}" FontSize="12.5" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                            <ProgressBar Value="{Binding ProgressValue}" Maximum="{Binding ProgressMax}" IsIndeterminate="{Binding ProgressUnknown}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
